---
// Schémas animés par chapitre — blueprint brutaliste enrichi (FR/ES)
// variant: candles | levels | range | context | trend | reversal | volume |
//          pullback | positionsize | stop | rr | drawdown | plan | zone | annotated | review
// DA v2 (12/08) : halos de fond, gradients de zone, ticks de prix, labels hiérarchisés,
// animation en cascade (draw → fills → labels), markers à uid unique (évite les collisions
// quand plusieurs instances du même variant vivent sur une page).
interface Props { variant: string; lang?: 'fr' | 'es'; }
const { variant, lang = 'fr' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

// Labels localisés (FR + ES) pour tous les textes SVG/aria
const L = {
  fr: {
    candles: { aria: "Anatomie d'un chandelier japonais", corps: 'corps', meche: 'mèche' },
    levels: { aria: 'Support et résistance en zones', res: 'RÉSISTANCE', sup: 'SUPPORT', prix: 'prix' },
    range: { aria: 'Range et cassure', range: 'RANGE', cassure: 'CASSURE ▲' },
    context: { aria: 'Lire la bougie dans son contexte', tend: 'TENDANCE ▲', sens: 'bougie dans le sens', value: 'zone de value' },
    trend: { aria: 'Tendance haussière HH HL', hh: 'HH', hl: 'HL' },
    reversal: { aria: 'Double bottom retournement', w: 'W · double bottom', cou: 'COU (neckline)' },
    volume: { aria: 'Prix et volume de confirmation', vol: 'VOLUME (confirmation)', cass: '▲ cassure sur volume' },
    pullback: { aria: 'Pullback et retest', retest: 'RETEST ✓', entree: 'entrée' },
    positionsize: { aria: 'Calcul de la taille de position', capital: 'CAPITAL', risque: 'RISQUE', ecart: 'ÉCART', entreeStop: 'entrée−stop', taille: 'TAILLE DU LOT' },
    stop: { aria: 'Entrée stop et target', entree: 'ENTRÉE', stop: 'STOP', target: 'TARGET', r1: '1R' },
    rr: { aria: 'Risk reward R-multiple', r1: '1R risque', r3: '3R gain', ratio: 'RATIO 1:3' },
    drawdown: { aria: 'Courbe de drawdown', dd: 'DRAWDOWN −18%', sommet: 'nouveau sommet' },
    plan: { aria: 'Plan de trade', contexte: 'Contexte', setup: 'Setup', est: 'Entrée / Stop / Target', raison: 'La raison', exec: 'EXÉCUTION' },
    zone: { aria: "Zone d'entrée", zone: 'ZONE DE DEMANDE', entry: 'ENTRY au rebond' },
    annotated: { aria: 'Setup annoté', pourquoi: 'pourquoi : retest + volume' },
    review: { aria: 'Journal de trade', journal: 'JOURNAL', journalFull: 'JOURNAL DE TRADE' },
  },
  es: {
    candles: { aria: "Anatomía de una vela japonesa", corps: 'cuerpo', meche: 'mecha' },
    levels: { aria: 'Soporte y resistencia en zonas', res: 'RESISTENCIA', sup: 'SOPORTE', prix: 'precio' },
    range: { aria: 'Rango y ruptura', range: 'RANGO', cassure: 'RUPTURA ▲' },
    context: { aria: 'Leer la vela en su contexto', tend: 'TENDENCIA ▲', sens: 'vela a favor', value: 'zona de valor' },
    trend: { aria: 'Tendencia alcista HH HL', hh: 'HH', hl: 'HL' },
    reversal: { aria: 'Doble suelo giro', w: 'W · doble suelo', cou: 'CUELLO (neckline)' },
    volume: { aria: 'Precio y volumen de confirmación', vol: 'VOLUMEN (confirmación)', cass: '▲ ruptura con volumen' },
    pullback: { aria: 'Pullback y retest', retest: 'RETEST ✓', entree: 'entrada' },
    positionsize: { aria: 'Cálculo del tamaño de posición', capital: 'CAPITAL', risque: 'RIESGO', ecart: 'ECARTE', entreeStop: 'entrada−stop', taille: 'TAMAÑO DEL LOTE' },
    stop: { aria: 'Entrada stop y objetivo', entree: 'ENTRADA', stop: 'STOP', target: 'OBJETIVO', r1: '1R' },
    rr: { aria: 'Risk reward R-múltiple', r1: '1R riesgo', r3: '3R ganancia', ratio: 'RATIO 1:3' },
    drawdown: { aria: 'Curva de drawdown', dd: 'DRAWDOWN −18%', sommet: 'nuevo máximo' },
    plan: { aria: 'Plan de trade', contexte: 'Contexto', setup: 'Setup', est: 'Entrada / Stop / Objetivo', raison: 'La razón', exec: 'EJECUCIÓN' },
    zone: { aria: "Zona de entrada", zone: 'ZONA DE DEMANDA', entry: 'ENTRY en el rebote' },
    annotated: { aria: 'Setup anotado', pourquoi: 'por qué : retest + volumen' },
    review: { aria: 'Diario de trade', journal: 'DIARIO', journalFull: 'DIARIO DE TRADE' },
  },
}[lang];
---
<div class="cd" data-reveal>
  {variant === 'candles' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.candles.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.10)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      {[24,80,136,192].map((y,i)=>(<text class="cd__ytick" x="38" y={y+4} text-anchor="end">{['64.5k','64.0k','63.5k','63.0k'][i]}</text>))}
      <rect class="cd__valuezone" x="44" y="108" width="288" height="40" rx="6"/>
      <g class="cd__fill up"><line class="cd__wick" x1="80" y1="52" x2="80" y2="160"/><rect x="66" y="80" width="28" height="58" rx="3"/></g>
      <g class="cd__fill down"><line class="cd__wick" x1="140" y1="40" x2="140" y2="172"/><rect x="126" y="88" width="28" height="64" rx="3"/></g>
      <g class="cd__fill up"><line class="cd__wick" x1="200" y1="62" x2="200" y2="152"/><rect x="186" y="74" width="28" height="52" rx="3"/></g>
      <g class="cd__fill down"><line class="cd__wick" x1="262" y1="48" x2="262" y2="186"/><rect x="248" y="108" width="28" height="60" rx="3"/></g>
      <g class="cd__call">
        <line class="cd__callline" x1="96" y1="118" x2="150" y2="148"/>
        <text class="cd__lbl" x="156" y="152">{L.candles.corps}</text>
        <line class="cd__callline" x1="126" y1="52" x2="150" y2="30"/>
        <text class="cd__lbl" x="156" y="34">{L.candles.meche}</text>
      </g>
      <text class="cd__lbl dim" x="52" y="116">{L.candles.prix}</text>
    </svg>
  )}

  {variant === 'levels' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.levels.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(47,111,224,0.09)"/>
          <stop offset="100%" stop-color="rgba(47,111,224,0)"/>
        </radialGradient>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      {[24,80,136,192].map((y,i)=>(<text class="cd__ytick" x="38" y={y+4} text-anchor="end">{['1.1050','1.0950','1.0850','1.0750'][i]}</text>))}
      <rect class="cd__zone" x="44" y="40" width="288" height="48"/>
      <rect class="cd__zone" x="44" y="156" width="288" height="48"/>
      <line class="cd__line res" x1="44" y1="48" x2="332" y2="48"/>
      <line class="cd__line sup" x1="44" y1="164" x2="332" y2="164"/>
      <polyline class="cd__line price" points="60,180 110,120 170,150 230,84 300,110"/>
      <g class="cd__fill up"><path class="cd__arrow" d="M60 176 L60 140"/><path class="cd__arrowhead" d="M56 148 L60 136 L64 148"/></g>
      <circle class="cd__pulse" cx="230" cy="84" r="6"/>
      <text class="cd__lbl up" x="52" y="42">{L.levels.res} · 1.1050</text>
      <text class="cd__lbl down" x="52" y="196">{L.levels.sup} · 1.0850</text>
      <text class="cd__lbl" x="240" y="80">{L.levels.prix}</text>
    </svg>
  )}

  {variant === 'range' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.range.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
        <marker id={`ah-${uid}`} markerWidth="11" markerHeight="11" refX="6.5" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="#1FD6A6"/></marker>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <rect class="cd__rangefill" x="44" y="76" width="288" height="96" rx="8"/>
      <line class="cd__line res" x1="44" y1="76" x2="332" y2="76"/>
      <line class="cd__line sup" x1="44" y1="172" x2="332" y2="172"/>
      <polyline class="cd__line price" points="60,150 100,90 140,160 180,100 220,150 260,104"/>
      <path class="cd__line break" d="M260 104 L320 56" marker-end={`url(#ah-${uid})`}/>
      <text class="cd__lbl" x="52" y="68">{L.range.range}</text>
      <text class="cd__lbl" x="52" y="196">{L.range.range}</text>
      <text class="cd__lbl up" x="242" y="52">{L.range.cassure}</text>
    </svg>
  )}

  {variant === 'context' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.context.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <polyline class="cd__line trend" points="50,180 110,136 170,146 240,92 320,68"/>
      <rect class="cd__valuezone" x="160" y="128" width="120" height="56" rx="8"/>
      <g class="cd__fill up"><rect x="288" y="62" width="24" height="48" rx="3"/></g>
      <rect class="cd__zone" x="44" y="156" width="288" height="44"/>
      <text class="cd__lbl" x="52" y="150">{L.context.tend}</text>
      <text class="cd__lbl up" x="236" y="202">{L.context.sens}</text>
      <text class="cd__lbl down" x="52" y="212">{L.context.value}</text>
    </svg>
  )}

  {variant === 'trend' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.trend.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
        <marker id={`ah-${uid}`} markerWidth="11" markerHeight="11" refX="6.5" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="#1FD6A6"/></marker>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <line class="cd__slope" x1="56" y1="186" x2="280" y2="52"/>
      <polyline class="cd__line trend" points="56,186 130,136 200,110 280,52"/>
      <circle class="cd__pulse" cx="56" cy="186" r="5"/>
      <circle class="cd__pulse" cx="130" cy="136" r="5"/>
      <circle class="cd__pulse" cx="200" cy="110" r="5"/>
      <circle class="cd__pulse" cx="280" cy="52" r="5"/>
      <text class="cd__lbl up" x="140" y="128">{L.trend.hh}</text>
      <text class="cd__lbl up" x="64" y="178">{L.trend.hl}</text>
      <path class="cd__line dim" d="M130 136 L200 110" marker-end={`url(#ah-${uid})`}/>
    </svg>
  )}

  {variant === 'reversal' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.reversal.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
        <marker id={`ah-${uid}`} markerWidth="11" markerHeight="11" refX="6.5" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="#1FD6A6"/></marker>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <rect class="cd__rangefill" x="44" y="88" width="288" height="64" rx="8"/>
      <polyline class="cd__line price" points="60,80 120,176 180,80 240,176 300,80"/>
      <line class="cd__line neck" x1="60" y1="80" x2="300" y2="80"/>
      <path class="cd__line break" d="M300 80 L320 52" marker-end={`url(#ah-${uid})`}/>
      <circle class="cd__pulse" cx="120" cy="176" r="5"/>
      <circle class="cd__pulse" cx="240" cy="176" r="5"/>
      <text class="cd__lbl down" x="110" y="214">{L.reversal.w}</text>
      <text class="cd__lbl up" x="180" y="72">{L.reversal.cou}</text>
    </svg>
  )}

  {variant === 'volume' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.volume.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <polyline class="cd__line price" points="50,170 110,104 170,126 240,70 310,48"/>
      <g>
        {[70,105,140,175,210,245,280,315].map((x,i)=>{
          const h = i===3 ? 100 : (i%2?46:74);
          const hl = i===3;
          return <rect class={hl ? "cd__bar hot" : "cd__bar"} x={x-9} y={216-h} width="18" height={h}/>;
        })}
      </g>
      <text class="cd__lbl" x="52" y="228">{L.volume.vol}</text>
      <text class="cd__lbl up" x="214" y="62">{L.volume.cass}</text>
    </svg>
  )}

  {variant === 'pullback' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.pullback.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
        <marker id={`ah-${uid}`} markerWidth="11" markerHeight="11" refX="6.5" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="#1FD6A6"/></marker>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      <rect class="cd__rangefill" x="44" y="128" width="288" height="44" rx="8"/>
      <polyline class="cd__line trend" points="50,180 120,110 180,132 240,74 320,66"/>
      <line class="cd__line sup" x1="44" y1="132" x2="332" y2="132"/>
      <path class="cd__line entry" d="M180 132 L180 94" marker-end={`url(#ah-${uid})`}/>
      <circle class="cd__pulse" cx="180" cy="132" r="6"/>
      <text class="cd__lbl up" x="140" y="124">{L.pullback.retest}</text>
      <text class="cd__lbl" x="190" y="90">{L.pullback.entree}</text>
    </svg>
  )}

  {variant === 'positionsize' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.positionsize.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(201,154,18,0.10)"/>
          <stop offset="100%" stop-color="rgba(201,154,18,0)"/>
        </radialGradient>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <path class="cd__flow" d="M106 82 L128 82"/>
      <path class="cd__flow" d="M198 82 L216 82"/>
      <path class="cd__flow" d="M268 114 L268 140"/>
      <path class="cd__flow" d="M196 170 L170 170"/>
      <g class="cd__box b1"><rect x="20" y="50" width="86" height="64" rx="8"/><text class="cd__bx" x="63" y="80" text-anchor="middle">{L.positionsize.capital}</text><text class="cd__bxv" x="63" y="104" text-anchor="middle">10 000 €</text></g>
      <text class="cd__op" x="112" y="90">×</text>
      <g class="cd__box b2"><rect x="128" y="50" width="70" height="64" rx="8"/><text class="cd__bx" x="163" y="80" text-anchor="middle">{L.positionsize.risque}</text><text class="cd__bxv" x="163" y="104" text-anchor="middle">1%</text></g>
      <text class="cd__op" x="202" y="90">÷</text>
      <g class="cd__box b3"><rect x="216" y="50" width="104" height="64" rx="8"/><text class="cd__bx" x="268" y="76" text-anchor="middle">{L.positionsize.ecart}</text><text class="cd__bxv" x="268" y="100" text-anchor="middle">{L.positionsize.entreeStop}</text></g>
      <text class="cd__op" x="274" y="152">=</text>
      <g class="cd__box res"><rect x="170" y="156" width="148" height="40" rx="8"/><text class="cd__bxv" x="244" y="182" text-anchor="middle">{L.positionsize.taille}</text></g>
    </svg>
  )}

  {variant === 'stop' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.stop.aria}>
      <defs>
        <radialGradient id={`halo-${uid}`} cx="78%" cy="12%" r="75%">
          <stop offset="0%" stop-color="rgba(31,214,166,0.09)"/>
          <stop offset="100%" stop-color="rgba(31,214,166,0)"/>
        </radialGradient>
        <marker id={`ah-${uid}`} markerWidth="11" markerHeight="11" refX="6.5" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="#1FD6A6"/></marker>
      </defs>
      <rect class="cd__halo" x="8" y="8" width="324" height="224" rx="12" fill={`url(#halo-${uid})`}/>
      <g class="cd__grid">{Array.from({length:7}).map((_,i)=>(<line class="cd__gridline" x1="44" y1={24+i*28} x2="332" y2={24+i*28}/>))}</g>
      <line class="cd__axis" x1="44" y1="20" x2="44" y2="220"/>
      {[40,100,160].map((y,i)=>(<text class="cd__ytick" x="38" y={y+4} text-anchor="end">{['62.0','61.0','60.0'][i]}</text>))}
      <rect class="cd__rzone" x="120" y="34" width="160" height="76" rx="8"/>
      <line class="cd__ref" x1="44" y1="110" x2="332" y2="110"/>
      <line class="cd__line entry" x1="120" y1="34" x2="120" y2="186"/>
      <line class="cd__line stop" x1="96" y1="174" x2="96" y2="194"/>
      <line class="cd__line tp" x1="280" y1="28" x2="280" y2="186"/>
      <text class="cd__lbl" x="128" y="52">{L.stop.entree} 61.0</text>
      <text class="cd__lbl down" x="58" y="196">{L.stop.stop} 60.0</text>
      <text class="cd__lbl up" x="238" y="42">{L.stop.target} 62.0</text>
      <path class="cd__line dim" d="M120 110 L96 110" marker-end={`url(#ah-${uid})`}/>
      <text class="cd__lbl" x="92" y="104">{L.stop.r1}</text>
      <text class="cd__val" x="150" y="118">1R = 1.0</text>
    </svg>
  )}

  {variant === 'rr' && (
    <svg viewBox="0 0 340 240" class="cd__svg" role="img" aria-label={L.rr.aria}>
