<style>
  .cd { width: 100%; border: 1.5px solid var(--ligne); border-radius: var(--radius); background: var(--carte); padding: 16px; overflow: hidden; transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }
  .cd:hover { border-color: color-mix(in srgb, var(--accent, var(--lime)) 55%, var(--ligne)); box-shadow: 0 18px 44px -20px color-mix(in srgb, var(--accent, var(--lime)) 32%, rgba(20,19,15,0.25)); }
  .cd__svg { width: 100%; height: auto; display: block; }
  .cd__halo { opacity: 0; transition: opacity .5s ease; }
  .cd.in .cd__halo { opacity: 1; }

  /* Grille / axes */
  .cd__gridline { stroke: rgba(var(--encre-rgb), 0.055); stroke-width: 1; }
  .cd__axis { stroke: var(--encre-2); stroke-width: 1.5; opacity: .5; }
  .cd__ref { stroke: var(--encre-2); stroke-width: 1; stroke-dasharray: 2 3; opacity: .45; }
  .cd__ytick { fill: var(--encre-2); font: 600 9px/1 'Space Grotesk', sans-serif; opacity: .68; }

  /* Lignes : draw-on au scroll */
  .cd__line { fill: none; stroke: var(--lime); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 800; stroke-dashoffset: 0; }
  .cd.in .cd__line { animation: cddraw 1.25s ease forwards; }
  .cd__line.dim { stroke: var(--encre-2); stroke-width: 2; stroke-dasharray: 4 4; }
  .cd__slope { fill: none; stroke: rgba(var(--encre-rgb), 0.18); stroke-width: 1.5; stroke-dasharray: 3 5; }
  .cd__line.res { stroke: var(--jaune); } .cd__line.sup { stroke: var(--emeraude); }
  .cd__line.trend { stroke: var(--lime); } .cd__line.price { stroke: var(--bleu); }
  .cd__line.neck { stroke: var(--jaune); } .cd__line.entry { stroke: var(--lime); }
  .cd__line.stop { stroke: var(--rouge); } .cd__line.tp { stroke: var(--emeraude); }
  .cd__line.equity { stroke: var(--emeraude); } .cd__line.zone { stroke: var(--jaune); stroke-dasharray: 6 4; }
  .cd__line.break { stroke: var(--lime); }

  /* Flèches */
  .cd__arrow { fill: none; stroke: var(--emeraude); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 800; stroke-dashoffset: 0; }
  .cd.in .cd__arrow { animation: cddraw 1.1s .45s ease forwards; }
  .cd__arrowhead { fill: var(--emeraude); opacity: 0; }
  .cd.in .cd__arrowhead { animation: cdfade .3s .9s ease forwards; }

  /* Fills / blocs : apparition en cascade */
  .cd__fill { opacity: 0; transform: scale(.92); transform-origin: center; }
  .cd.in .cd__fill { animation: cdfill .6s .3s ease forwards; }
  .cd__fill.up rect { fill: var(--emeraude); } .cd__fill.up line { stroke: var(--emeraude); }
  .cd__fill.down rect { fill: var(--rouge); } .cd__fill.down line { stroke: var(--rouge); }
  .cd__wick { stroke: var(--encre-2); stroke-width: 2; }

  /* Zones */
  .cd__zone { fill: rgba(var(--lime-rgb), 0.12); stroke: var(--lime); stroke-width: 1.5; stroke-dasharray: 5 4; rx: 8; opacity: 0; }
  .cd.in .cd__zone { animation: cdfill .7s .35s ease forwards; }
  .cd__zone.zn { fill: rgba(var(--bleu-rgb), 0.13); stroke: var(--bleu); }
  .cd__zone.dd { fill: rgba(var(--rouge-rgb), 0.16); stroke: none; }
  .cd__rangefill { fill: rgba(var(--lime-rgb), 0.07); stroke: none; opacity: 0; }
  .cd.in .cd__rangefill { animation: cdfill .6s .3s ease forwards; }
  .cd__valuezone { fill: rgba(var(--lime-rgb), 0.06); stroke: none; opacity: 0; }
  .cd.in .cd__valuezone { animation: cdfill .6s .4s ease forwards; }
  .cd__rzone { fill: rgba(var(--emeraude-rgb), 0.08); stroke: none; opacity: 0; }
  .cd.in .cd__rzone { animation: cdfill .6s .5s ease forwards; }

  /* Pulse */
  .cd__pulse { fill: var(--lime); animation: cdpulse 1.8s ease-in-out infinite; }

  /* Barres */
  .cd__bar { fill: rgba(var(--bleu-rgb), 0.55); transform: scaleY(0); transform-origin: bottom; }
  .cd.in .cd__bar { animation: cdbar .7s ease forwards; }
  .cd__bar.risk { fill: rgba(var(--rouge-rgb), 0.55); }
  .cd__bar.reward { fill: rgba(var(--emeraude-rgb), 0.55); }
  .cd__bar.hot { fill: var(--lime); }

  /* Labels : fade-up en cascade */
  .cd__lbl { fill: var(--encre-2); font: 700 10px/1 'Space Grotesk', sans-serif; letter-spacing: 0.08em; opacity: 0; }
  .cd.in .cd__lbl { animation: cdfade .45s .55s ease forwards; }
  .cd__lbl.up { fill: var(--emeraude); } .cd__lbl.down { fill: var(--rouge); }
  .cd__lbl.dim { fill: var(--encre-2); opacity: .55; }
  .cd__val { font: 700 12px/1 'Newsreader', serif; letter-spacing: 0; opacity: 0; }
  .cd.in .cd__val { animation: cdfade .45s .7s ease forwards; }
  .cd__val.up { fill: var(--emeraude); } .cd__val.down { fill: var(--rouge); }

  /* Boîtes de calcul */
  .cd__box rect { fill: var(--carte); stroke: var(--ligne-2); stroke-width: 2; rx: 8; filter: drop-shadow(0 6px 14px rgba(20,19,15,0.08)); opacity: 0; }
  .cd.in .cd__box rect { animation: cdfill .5s ease forwards; }
  .cd.in .cd__box.b2 rect { animation-delay: .15s; }
  .cd.in .cd__box.b3 rect { animation-delay: .3s; }
  .cd.in .cd__box.res rect { animation-delay: .5s; }
  .cd__box.res rect { fill: rgba(var(--lime-rgb), 0.16); stroke: var(--lime); }
  .cd__bx { fill: var(--encre-2); font: 700 9px/1 'Space Grotesk', sans-serif; letter-spacing: 0.04em; opacity: 0; }
  .cd.in .cd__bx { animation: cdfade .4s .35s ease forwards; }
  .cd__bxv { fill: var(--encre); font: 700 11px/1 'Newsreader', serif; opacity: 0; }
  .cd.in .cd__bxv { animation: cdfade .4s .5s ease forwards; }
  .cd.in .cd__box.res .cd__bxv { animation-delay: .7s; }
  .cd__op { fill: var(--lime-text); font: 700 22px/1 'Newsreader', serif; opacity: 0; }
  .cd.in .cd__op { animation: cdfade .4s .45s ease forwards; }
  .cd__flow { fill: none; stroke: var(--ligne-2); stroke-width: 2; stroke-dasharray: 3 3; opacity: 0; }
  .cd.in .cd__flow { animation: cdfade .4s .3s ease forwards; }

  /* Checkbox + page journal */
  .cd__check rect { fill: none; stroke: var(--emeraude); stroke-width: 2.5; opacity: 0; }
  .cd.in .cd__check rect { animation: cdfill .4s ease forwards; }
  .cd__check path { fill: none; stroke: var(--emeraude); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 40; stroke-dashoffset: 40; }
  .cd.in .cd__check path { animation: cdcheck .45s .5s ease forwards; }
  .cd__page { fill: var(--carte); stroke: var(--ligne-2); stroke-width: 2; }
  .cd__line.jl { stroke: var(--encre-2); stroke-width: 2; stroke-dasharray: 4 3; opacity: 0; }
  .cd.in .cd__line.jl { animation: cdfade .4s .4s ease forwards; }
  .cd__star { fill: var(--jaune); font: 700 16px/1 'Newsreader', serif; opacity: 0; }
  .cd.in .cd__star { animation: cdfade .4s .7s ease forwards; }

  /* Lignes d'appel (anatomie) */
  .cd__callline { stroke: rgba(var(--encre-rgb), 0.25); stroke-width: 1.2; stroke-dasharray: 3 3; opacity: 0; }
  .cd.in .cd__callline { animation: cdfade .4s .85s ease forwards; }

  @keyframes cddraw { from { stroke-dashoffset: 800; } to { stroke-dashoffset: 0; } }
  @keyframes cdfill { to { opacity: 1; transform: scale(1); } }
  @keyframes cdfade { to { opacity: 1; } }
  @keyframes cdpulse { 0%,100% { opacity: 1; } 50% { opacity: .3; } }
  @keyframes cdbar { to { transform: scaleY(1); } }
  @keyframes cdcheck { to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .cd__line, .cd__arrow, .cd__check path { stroke-dashoffset: 0; }
    .cd__fill, .cd__zone, .cd__rangefill, .cd__valuezone, .cd__rzone, .cd__bar, .cd__box rect, .cd__halo { opacity: 1; transform: none; }
    .cd__lbl, .cd__val, .cd__bx, .cd__bxv, .cd__op, .cd__flow, .cd__star, .cd__line.jl, .cd__callline { opacity: 1; }
    .cd__pulse { animation: none; }
    .cd.in .cd__line, .cd.in .cd__fill, .cd.in .cd__bar, .cd.in .cd__zone, .cd.in .cd__box rect, .cd.in .cd__check path, .cd.in .cd__lbl, .cd.in .cd__val, .cd.in .cd__arrow { animation: none; }
  }
</style>
