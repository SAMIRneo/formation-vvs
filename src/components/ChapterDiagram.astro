---
// Schémas animés par chapitre — blueprint brutaliste
// variant: candles | levels | range | context | trend | reversal | volume |
//          pullback | positionsize | stop | rr | drawdown | plan | zone | annotated | review
interface Props { variant: string; }
const { variant } = Astro.props;
---
<div class="cd" data-reveal>
  {variant === 'candles' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Anatomie d'un chandelier japonais">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <g class="cd__fill up"><line class="cd__wick" x1="60" y1="40" x2="60" y2="150"/><rect x="50" y="70" width="20" height="50"/></g>
      <g class="cd__fill down"><line class="cd__wick" x1="120" y1="30" x2="120" y2="160"/><rect x="110" y="80" width="20" height="55"/></g>
      <g class="cd__fill up"><line class="cd__wick" x1="180" y1="50" x2="180" y2="140"/><rect x="170" y="65" width="20" height="45"/></g>
      <g class="cd__fill down"><line class="cd__wick" x1="240" y1="35" x2="240" y2="170"/><rect x="230" y="95" width="20" height="50"/></g>
      <text class="cd__lbl" x="60" y="188" text-anchor="middle">corps</text>
      <text class="cd__lbl" x="120" y="188" text-anchor="middle">mèche</text>
    </svg>
  )}
  {variant === 'levels' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Support et résistance en zones">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <rect class="cd__zone" x="0" y="40" width="320" height="120"/>
      <line class="cd__line res" x1="0" y1="48" x2="320" y2="48"/>
      <line class="cd__line sup" x1="0" y1="152" x2="320" y2="152"/>
      <text class="cd__lbl up" x="8" y="42">RÉSISTANCE</text>
      <text class="cd__lbl down" x="8" y="172">SUPPORT</text>
      <circle class="cd__pulse" cx="160" cy="100" r="6"/>
    </svg>
  )}
  {variant === 'range' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Range et cassure">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <line class="cd__line res" x1="0" y1="60" x2="320" y2="60"/>
      <line class="cd__line sup" x1="0" y1="150" x2="320" y2="150"/>
      <polyline class="cd__line price" points="40,135 80,70 120,130 160,80 200,120 240,90 270,90"/>
      <path class="cd__line break" d="M270 90 L300 50" marker-end="url(#ah)"/>
      <text class="cd__lbl" x="8" y="54">RANGE</text>
      <text class="cd__lbl up" x="250" y="44">CASSURE</text>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'context' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Lire la bougie dans son contexte">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line trend" points="20,160 90,120 150,130 220,80 300,60"/>
      <g class="cd__fill up"><rect x="250" y="55" width="18" height="40"/></g>
      <line class="cd__line zone" x1="0" y1="150" x2="320" y2="150"/>
      <text class="cd__lbl" x="8" y="144">TENDANCE ↑</text>
      <text class="cd__lbl up" x="250" y="188">dans le sens</text>
    </svg>
  )}
  {variant === 'trend' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Tendance haussière HH HL">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line trend" points="30,160 110,120 180,100 260,50"/>
      <circle class="cd__pulse" cx="30" cy="160" r="5"/>
      <circle class="cd__pulse" cx="110" cy="120" r="5"/>
      <circle class="cd__pulse" cx="180" cy="100" r="5"/>
      <circle class="cd__pulse" cx="260" cy="50" r="5"/>
      <text class="cd__lbl up" x="120" y="92">HH</text>
      <text class="cd__lbl up" x="50" y="150">HL</text>
    </svg>
  )}
  {variant === 'reversal' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Double bottom retournement">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line price" points="30,80 90,160 150,80 210,160 270,80"/>
      <line class="cd__line neck" x1="30" y1="80" x2="270" y2="80"/>
      <text class="cd__lbl down" x="60" y="178">W</text>
      <text class="cd__lbl up" x="150" y="72">COU</text>
    </svg>
  )}
  {variant === 'volume' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Prix et volume de confirmation">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line price" points="20,150 90,90 160,110 230,60 300,40"/>
      <g>
        {[30,65,100,135,170,205,240,275].map((x,i)=>(<rect class="cd__bar" x={x-7} y={170-(i%2?40:70)} width="14" height={(i%2?40:70)}/>))}
      </g>
      <text class="cd__lbl" x="8" y="192">VOLUME</text>
    </svg>
  )}
  {variant === 'pullback' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Pullback et retest">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line trend" points="20,150 100,90 160,110 220,60 300,55"/>
      <line class="cd__line sup" x1="0" y1="110" x2="320" y2="110"/>
      <path class="cd__line entry" d="M160 110 L160 80" marker-end="url(#ah)"/>
      <text class="cd__lbl up" x="120" y="104">RETEST</text>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'positionsize' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Calcul de la taille de position">
      <g class="cd__box b1"><rect x="10" y="60" width="80" height="60" rx="8"/><text class="cd__bx" x="50" y="88" text-anchor="middle">CAPITAL</text><text class="cd__bxv" x="50" y="108" text-anchor="middle">10k€</text></g>
      <text class="cd__op" x="100" y="95">×</text>
      <g class="cd__box b2"><rect x="120" y="60" width="70" height="60" rx="8"/><text class="cd__bx" x="155" y="88" text-anchor="middle">RISQUE</text><text class="cd__bxv" x="155" y="108" text-anchor="middle">1%</text></g>
      <text class="cd__op" x="198" y="95">÷</text>
      <g class="cd__box b3"><rect x="210" y="60" width="90" height="60" rx="8"/><text class="cd__bx" x="255" y="85" text-anchor="middle">ÉCART</text><text class="cd__bxv" x="255" y="105" text-anchor="middle">entrée−stop</text></g>
      <text class="cd__op" x="155" y="150">=</text>
      <g class="cd__box res"><rect x="100" y="155" width="120" height="36" rx="8"/><text class="cd__bxv" x="160" y="178" text-anchor="middle">TAILLE DU LOT</text></g>
    </svg>
  )}
  {variant === 'stop' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Entrée stop et target">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <line class="cd__line entry" x1="60" y1="40" x2="60" y2="170"/>
      <line class="cd__line stop" x1="40" y1="160" x2="40" y2="180"/>
      <line class="cd__line tp" x1="250" y1="30" x2="250" y2="170"/>
      <text class="cd__lbl" x="64" y="52">ENTRÉE</text>
      <text class="cd__lbl down" x="8" y="178">STOP</text>
      <text class="cd__lbl up" x="220" y="42">TARGET</text>
      <path class="cd__line" d="M60 100 L40 100" marker-end="url(#ah)"/>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'rr' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Risk reward R-multiple">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <rect class="cd__bar risk" x="40" y="40" width="40" height="120"/>
      <rect class="cd__bar reward" x="120" y="40" width="40" height="120"/>
      <rect class="cd__bar reward" x="170" y="40" width="40" height="120"/>
      <rect class="cd__bar reward" x="220" y="40" width="40" height="120"/>
      <text class="cd__lbl down" x="60" y="178" text-anchor="middle">1R risque</text>
      <text class="cd__lbl up" x="190" y="178" text-anchor="middle">3R gain</text>
    </svg>
  )}
  {variant === 'drawdown' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Courbe de drawdown">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line equity" points="20,60 90,70 150,130 200,120 270,50 300,45"/>
      <path class="cd__zone dd" d="M90 70 L150 130 L200 120 L200 70 L150 70 L90 70 Z"/>
      <text class="cd__lbl down" x="130" y="155">DRAWDOWN</text>
    </svg>
  )}
  {variant === 'plan' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Plan de trade">
      <g class="cd__check"><rect x="20" y="30" width="20" height="20" rx="5"/><path d="M24 40 L28 45 L36 33" /></g>
      <text class="cd__lbl" x="52" y="46">Contexte</text>
      <g class="cd__check"><rect x="20" y="70" width="20" height="20" rx="5"/><path d="M24 80 L28 85 L36 73" /></g>
      <text class="cd__lbl" x="52" y="86">Setup</text>
      <g class="cd__check"><rect x="20" y="110" width="20" height="20" rx="5"/><path d="M24 120 L28 125 L36 113" /></g>
      <text class="cd__lbl" x="52" y="126">Entrée / Stop / Target</text>
      <g class="cd__check"><rect x="20" y="150" width="20" height="20" rx="5"/><path d="M24 160 L28 165 L36 153" /></g>
      <text class="cd__lbl" x="52" y="166">La raison</text>
      <path class="cd__line" d="M260 40 L260 160" marker-end="url(#ah)"/>
      <text class="cd__lbl up" x="250" y="186">EXÉCUTION</text>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'zone' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Zone d'entrée">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <rect class="cd__zone zn" x="60" y="70" width="120" height="70"/>
      <polyline class="cd__line price" points="20,160 80,120 140,140 200,90 280,60"/>
      <path class="cd__line entry" d="M140 140 L140 90" marker-end="url(#ah)"/>
      <text class="cd__lbl" x="80" y="64">ZONE</text>
      <text class="cd__lbl up" x="100" y="186">ENTRY rebond</text>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'annotated' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Setup annoté">
      <g class="cd__grid">
        {Array.from({length:6}).map((_,i)=>(<line class="cd__gridline" x1="0" y1={20+i*32} x2="320" y2={20+i*32}/>))}
      </g>
      <polyline class="cd__line price" points="20,150 90,100 150,120 220,60 290,50"/>
      <path class="cd__line entry" d="M150 120 L150 95" marker-end="url(#ah)"/>
      <line class="cd__line stop" x1="140" y1="140" x2="140" y2="155"/>
      <line class="cd__line tp" x1="240" y1="50" x2="240" y2="65"/>
      <text class="cd__lbl up" x="156" y="92">E</text>
      <text class="cd__lbl down" x="118" y="152">S</text>
      <text class="cd__lbl up" x="200" y="44">T</text>
      <defs><marker id="ah" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto"><path d="M0 0 L6 3 L0 6 Z" fill="#FF6A00"/></marker></defs>
    </svg>
  )}
  {variant === 'review' && (
    <svg viewBox="0 0 320 200" class="cd__svg" role="img" aria-label="Journal de trade">
      <rect class="cd__page" x="70" y="20" width="180" height="160" rx="10"/>
      <line class="cd__line jl" x1="90" y1="50" x2="230" y2="50"/>
      <line class="cd__line jl" x1="90" y1="75" x2="230" y2="75"/>
      <line class="cd__line jl" x1="90" y1="100" x2="200" y2="100"/>
      <text class="cd__star" x="90" y="135">★★★★</text>
      <text class="cd__lbl" x="170" y="135">3/5</text>
      <text class="cd__lbl" x="90" y="168">JOURNAL</text>
    </svg>
  )}
</div>

<style>
  .cd { width: 100%; border: var(--border-w) solid var(--ligne); border-radius: var(--radius); background: var(--charbon-3); padding: 16px; overflow: hidden; }
  .cd__svg { width: 100%; height: auto; display: block; }
  .cd__gridline { stroke: rgba(255,255,255,0.05); stroke-width: 1; }
  /* lignes qui se dessinent au reveal */
  .cd__line { fill: none; stroke: var(--orange); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 800; stroke-dashoffset: 0; }
  .cd.in .cd__line { animation: cddraw 1.3s ease forwards; }
  .cd__wick { stroke: var(--texte-2); stroke-width: 2; }
  .cd__fill { opacity: 0; transform: scale(.92); transform-origin: center; }
  .cd.in .cd__fill { animation: cdfill .6s ease forwards; }
  .cd__fill.up rect { fill: var(--emeraude); } .cd__fill.up line { stroke: var(--emeraude); }
  .cd__fill.down rect { fill: var(--rouge); } .cd__fill.down line { stroke: var(--rouge); }
  .cd__zone { fill: color-mix(in srgb, var(--orange) 10%, transparent); stroke: var(--orange); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .cd__zone.zn { fill: color-mix(in srgb, var(--bleu) 12%, transparent); stroke: var(--bleu); }
  .cd__zone.dd { fill: color-mix(in srgb, var(--rouge) 14%, transparent); stroke: none; }
  .cd__line.res { stroke: var(--jaune); } .cd__line.sup { stroke: var(--emeraude); }
  .cd__line.trend { stroke: var(--orange); } .cd__line.price { stroke: var(--bleu); }
  .cd__line.neck { stroke: var(--jaune); } .cd__line.entry { stroke: var(--orange); }
  .cd__line.stop { stroke: var(--rouge); } .cd__line.tp { stroke: var(--emeraude); }
  .cd__line.equity { stroke: var(--emeraude); } .cd__line.zone { stroke: var(--jaune); stroke-dasharray: 6 4; }
  .cd__line.break { stroke: var(--orange); }
  .cd__pulse { fill: var(--orange); animation: cdpulse 1.8s ease-in-out infinite; }
  .cd__bar { fill: color-mix(in srgb, var(--bleu) 60%, transparent); transform: scaleY(0); transform-origin: bottom; }
  .cd.in .cd__bar { animation: cdbar .7s ease forwards; }
  .cd__bar.risk { fill: color-mix(in srgb, var(--rouge) 60%, transparent); }
  .cd__bar.reward { fill: color-mix(in srgb, var(--emeraude) 60%, transparent); }
  .cd__lbl { fill: var(--texte-2); font: 700 10px/1 'Satoshi', sans-serif; letter-spacing: 0.08em; }
  .cd__lbl.up { fill: var(--emeraude); } .cd__lbl.down { fill: var(--rouge); }
  .cd__box rect { fill: var(--charbon-2); stroke: var(--ligne); stroke-width: 2; }
  .cd__box.res rect { fill: color-mix(in srgb, var(--orange) 16%, transparent); stroke: var(--orange); }
  .cd__bx { fill: var(--texte-2); font: 700 9px/1 'Satoshi', sans-serif; letter-spacing: 0.04em; }
  .cd__bxv { fill: var(--texte); font: 700 10px/1 'Clash Display', sans-serif; }
  .cd__op { fill: var(--orange); font: 700 22px/1 'Clash Display', sans-serif; }
  .cd__check rect { fill: none; stroke: var(--emeraude); stroke-width: 2.5; }
  .cd__check path { fill: none; stroke: var(--emeraude); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .cd__page { fill: var(--charbon-2); stroke: var(--ligne); stroke-width: 2; }
  .cd__line.jl { stroke: var(--texte-2); stroke-width: 2; stroke-dasharray: 4 3; }
  .cd__star { fill: var(--jaune); font: 700 16px/1 'Clash Display', sans-serif; }
  @keyframes cddraw { from { stroke-dashoffset: 800; } to { stroke-dashoffset: 0; } }
  @keyframes cdfill { to { opacity: 1; transform: scale(1); } }
  @keyframes cdpulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
  @keyframes cdbar { to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .cd__line { stroke-dashoffset: 0; } .cd__fill { opacity: 1; transform: none; } .cd__bar { transform: none; } .cd__pulse { animation: none; }
    .cd.in .cd__line, .cd.in .cd__fill, .cd.in .cd__bar { animation: none; }
  }
</style>
