---
interface Props {
  n: string;
  title: string;
  desc: string;
  tag: string;
  href: string;
  accent?: 'orange' | 'bleu' | 'jaune' | 'emeraude';
}
const { n, title, desc, tag, href, accent = 'orange' } = Astro.props;
const accentVar = { orange: 'var(--orange)', bleu: 'var(--bleu)', jaune: 'var(--jaune)', emeraude: 'var(--emeraude)' }[accent];
---
<a class="mod" href={href} style={`--accent:${accentVar}`}>
  <div class="mod__top">
    <span class="mod__n">{n}</span>
    <span class="mod__tag">{tag}</span>
  </div>
  <h3 class="mod__title">{title}</h3>
  <p class="mod__desc">{desc}</p>
  <span class="mod__open">Ouvrir →</span>
</a>

<style>
  .mod {
    display: block; background: var(--charbon-2); border: var(--border-w) solid var(--ligne);
    border-radius: var(--radius); padding: 20px; position: relative;
    transition: transform .14s ease, border-color .14s ease;
  }
  .mod::before {
    content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 4px;
    background: var(--accent); opacity: 0; transition: opacity .14s ease;
  }
  .mod:hover { transform: translateY(-4px); border-color: var(--accent); }
  .mod:hover::before { opacity: 1; }
  .mod__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .mod__n { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: var(--accent); letter-spacing: -0.04em; }
  .mod__tag { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--texte-2); border: 1px solid var(--ligne); padding: 3px 8px; border-radius: 5px; }
  .mod__title { font-size: 1.25rem; margin-bottom: 8px; }
  .mod__desc { font-size: 0.9rem; color: var(--texte-2); margin-bottom: 16px; }
  .mod__open { font-family: var(--font-body); font-weight: 700; font-size: 0.8rem; color: var(--accent); }
  .mod:hover .mod__open { letter-spacing: 0.02em; }
</style>
