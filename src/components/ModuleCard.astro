---
interface Props {
  n: string;
  title: string;
  desc: string;
  tag: string;
  href: string;
  accent?: 'orange' | 'bleu' | 'jaune' | 'emeraude';
}
const { n, title, desc, tag, href, accent = 'orange' } = Astro.props;
const accentVar = { orange: 'var(--lime)', bleu: 'var(--bleu)', jaune: 'var(--jaune)', emeraude: 'var(--emeraude)' }[accent];
---
<a class="mod" href={href} style={`--accent:${accentVar}`} data-reveal>
  <span class="mod__bar"></span>
  <div class="mod__top">
    <span class="mod__n">{n}</span>
    <span class="mod__tag">{tag}</span>
  </div>
  <h3 class="mod__title">{title}</h3>
  <p class="mod__desc">{desc}</p>
  <span class="mod__open">Ouvrir <span class="mod__arrow">→</span></span>
</a>

<style>
  .mod {
    display: block; position: relative; overflow: hidden;
    background: var(--charbon-2); border: var(--border-w) solid var(--ligne);
    border-radius: 12px; padding: 18px 18px 16px 22px;
    transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    box-shadow: var(--ombre-douce);
  }
  .mod__bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--accent); opacity: .85; }
  .mod::after {
    content: ''; position: absolute; right: -40%; top: -40%; width: 80%; height: 80%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%);
    opacity: 0; transition: opacity .25s ease; pointer-events: none;
  }
  .mod:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 22px 46px -22px color-mix(in srgb, var(--accent) 45%, transparent); }
  .mod:hover::after { opacity: 1; }
  .mod__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .mod__n { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--accent); letter-spacing: -0.04em; }
  .mod__tag { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--texte-2); border: 1px solid var(--ligne); padding: 3px 8px; border-radius: 5px; }
  .mod__title { font-size: 1.2rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: -0.02em; }
  .mod__desc { font-size: 0.86rem; color: var(--texte-2); margin-bottom: 14px; line-height: 1.45; }
  .mod__open { font-family: var(--font-body); font-weight: 700; font-size: 0.8rem; color: var(--accent); display: inline-flex; align-items: center; gap: 6px; }
  .mod__arrow { transition: transform .2s ease; }
  .mod:hover .mod__arrow { transform: translateX(4px); }
</style>
