---
interface Props {
  n: string;
  title: string;
  desc: string;
  tag: string;
  href: string;
  diagram?: string;
  accent?: 'orange' | 'bleu' | 'jaune' | 'emeraude';
}
const { n, title, desc, tag, href, diagram, accent = 'orange' } = Astro.props;
const accentVar = { orange: 'var(--lime)', bleu: 'var(--bleu)', jaune: 'var(--jaune)', emeraude: 'var(--emeraude)' }[accent];
const accentInkVar = { orange: 'var(--lime-ink)', bleu: 'var(--bleu-ink)', jaune: 'var(--jaune-ink)', emeraude: 'var(--emeraude-ink)' }[accent];
import ChapterDiagram from './ChapterDiagram.astro';
---
<a class="mod" href={href} style={`--accent:${accentVar}; --accent-ink:${accentInkVar}; --accent-rgb:${ { orange: '31,214,166', bleu: '47,111,224', jaune: '201,154,18', emeraude: '16,158,106' }[accent] }`} data-reveal>
  <span class="mod__bar"></span>
  <div class="mod__top">
    <span class="mod__n">{n}</span>
    <span class="mod__tag">{tag}</span>
  </div>
  <h3 class="mod__title">{title}</h3>
  <p class="mod__desc">{desc}</p>
  {diagram && (
    <div class="mod__diagram">
      <ChapterDiagram variant={diagram} lang="fr" />
    </div>
  )}
  <span class="mod__open">Ouvrir <span class="mod__arrow">→</span></span>
</a>

<style>
  .mod {
    display: flex; flex-direction: column; position: relative; overflow: hidden;
    background: var(--carte); border: 1.5px solid var(--ligne);
    border-radius: var(--radius); padding: 22px 22px 20px 26px;
    transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    box-shadow: var(--ombre);
  }
  .mod__bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--accent); opacity: .85; }
  .mod::after {
    content: ''; position: absolute; right: -40%; top: -40%; width: 80%; height: 80%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.16), transparent 70%);
    opacity: 0; transition: opacity .25s ease; pointer-events: none;
  }
  .mod:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 22px 46px -22px rgba(var(--accent-rgb), 0.40); }
  .mod:hover::after { opacity: 1; }
  .mod__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .mod__n { font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; color: var(--accent-ink); letter-spacing: -0.04em; }
  .mod__tag { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--encre-2); border: 1.5px solid var(--ligne); padding: 3px 8px; border-radius: 6px; }
  .mod__title { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; margin-bottom: 6px; letter-spacing: -0.01em; }
  .mod__desc { font-size: 0.86rem; color: var(--encre-2); margin-bottom: 16px; line-height: 1.45; }
  .mod__diagram {
    margin-bottom: 16px; border: 1.5px solid var(--ligne); border-radius: var(--radius-sm);
    background: var(--canvas); padding: 12px; overflow: hidden;
  }
  .mod__diagram :global(.cd) { border: none; padding: 0; background: transparent; box-shadow: none; }
  .mod__open { font-family: var(--font-mono); font-weight: 700; font-size: 0.78rem; color: var(--encre); display: inline-flex; align-items: center; gap: 6px; margin-top: auto; }
  .mod:hover .mod__open { color: var(--accent-ink); }
  .mod__arrow { transition: transform .2s ease; }
  .mod:hover .mod__arrow { transform: translateX(4px); }
</style>
