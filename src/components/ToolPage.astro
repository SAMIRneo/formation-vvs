---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent } from "../data/content";
import { getLang, t, localizedPath } from "../i18n/ui";
import RiskCalculator from "../components/RiskCalculator.astro";
import TradeJournal from "../components/TradeJournal.astro";
import Screener from "../components/Screener.astro";
import Watchlist from "../components/Watchlist.astro";

interface Props {
  tool: ReturnType<typeof getContent>["tools"][number];
}
const { tool } = Astro.props;
const lang = getLang(Astro.url);
---

<BaseLayout title={tool.t} description={tool.d} active="marche">
  <article class="outil wrap" data-reveal>
    <a href={localizedPath("/marche/", lang)} class="back"
      >{t(lang, "marche.toolsTitle")} ←</a
    >
    <header class="outil__head">
      <span class="outil__ic" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d={tool.icon}></path></svg
        >
      </span>
      <h1>{tool.t}</h1>
      <p class="lead">{tool.d}</p>
    </header>

    <p class="outil__body">{tool.body}</p>

    {tool.slug === "calculateur" && <RiskCalculator lang={lang} />}

    {tool.slug === "journal" && <TradeJournal lang={lang} />}
    {tool.slug === "screener" && <Screener lang={lang} />}
    {tool.slug === "veille" && <Watchlist lang={lang} />}

    <div class="cta-row">
      <a href={localizedPath("/modules/", lang)} class="btn"
        >{t(lang, "nav.modules")}</a
      >
      <a href={localizedPath("/abonnement/", lang)} class="btn btn--ghost"
        >{t(lang, "nav.abonnement")}</a
      >
    </div>
  </article>
</BaseLayout>

<style>
  .outil {
    max-width: 820px;
    padding: 48px 20px 64px;
  }
  .back {
    display: inline-block;
    color: var(--encre-2);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 18px;
  }
  .back:hover {
    color: var(--encre);
  }
  .outil__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 22px;
  }
  .outil__ic {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 11px;
    background: rgba(var(--lime-rgb), 0.14);
    color: var(--encre);
  }
  .outil__ic svg {
    width: 26px;
    height: 26px;
  }
  .outil h1 {
    font-size: clamp(2rem, 7vw, 3.2rem);
    text-wrap: balance;
  }
  .lead {
    color: var(--encre-2);
    font-size: 1.1rem;
    margin: 0;
  }
  .outil__body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--encre);
    margin-bottom: 36px;
  }

  .calc {
    background: var(--carte);
    border: 1.5px solid var(--ligne);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 36px;
    box-shadow: var(--ombre);
  }
  .calc__t {
    font-size: clamp(1.3rem, 5vw, 1.8rem);
    margin-bottom: 18px;
  }
  .calc__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .calc__f {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--encre-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .calc__f input {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--encre);
    background: var(--carte);
    border: 1.5px solid var(--ligne-2);
    border-radius: 8px;
    padding: 11px 12px;
  }
  .calc__f input:focus {
    outline: 2px solid var(--lime);
    outline-offset: 1px;
    border-color: var(--encre);
  }
  .calc__out {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 18px;
    border-top: 1px solid var(--ligne);
  }
  .calc__lbl {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--encre-2);
  }
  .calc__val {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3rem);
    color: var(--emeraude);
    letter-spacing: -0.03em;
  }
  .calc__sub {
    font-size: 0.85rem;
    color: var(--encre-2);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  @media (max-width: 760px) {
    .outil {
      padding: 36px 16px 56px;
    }
    .calc__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
