---
// Veille marché — liste de niveaux clés ÉDITABLE (localStorage), 100% client
interface Props {
  lang?: "fr" | "es";
}
const { lang = "fr" } = Astro.props;
const L = {
  fr: {
    title: "Veille marché",
    sub: "Tes zones et événements. Sélectionne une note pour la modifier.",
    add: "Ajouter un niveau",
    ph: "ex. BTC/EUR 58k support",
    empty: "Aucune note. Ajoute une zone ou un événement.",
    clear: "Tout effacer",
    exp: "Exporter",
  },
  es: {
    title: "Vigilancia de mercado",
    sub: "Tus zonas y eventos. Selecciona una nota para editarla.",
    add: "Añadir nivel",
    ph: "ej. BTC/EUR 58k soporte",
    empty: "Sin notas. Añade una zona o un evento.",
    clear: "Borrar todo",
    exp: "Exportar",
  },
}[lang];
---

<div class="watch" data-reveal data-lang={lang}>
  <div class="watch__head">
    <div>
      <h2 class="watch__t">{L.title}</h2>
      <p class="watch__sub">{L.sub}</p>
    </div>
    <div class="watch__tools">
      <button class="journal__btn" data-export type="button">{L.exp}</button>
      <button class="journal__btn journal__btn--ghost" data-clear type="button"
        >{L.clear}</button
      >
    </div>
  </div>

  <form class="watch__add" data-form>
    <input name="lvl" placeholder={L.ph} aria-label={L.ph} autocomplete="off" />
    <button class="btn" type="submit">{L.add}</button>
  </form>

  <ul class="watch__list" data-list>
    <li class="watch__empty" data-empty>{L.empty}</li>
  </ul>
</div>

<style>
  .watch {
    background: var(--carte);
    border: 1.5px solid var(--ligne);
    border-radius: 14px;
    padding: 22px;
    box-shadow: var(--ombre);
  }
  .watch__head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .watch__t {
    font-size: clamp(1.3rem, 5vw, 1.9rem);
    margin: 0;
  }
  .watch__sub {
    color: var(--encre-2);
    font-size: 0.9rem;
    margin: 4px 0 0;
    max-width: 44ch;
  }
  .watch__tools {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
    align-items: center;
  }
  .journal__btn {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 7px 11px;
    border: 1.5px solid var(--ligne);
    border-radius: 7px;
    background: transparent;
    color: var(--encre-2);
    cursor: pointer;
    transition: all 0.12s ease;
  }
  .journal__btn:hover {
    border-color: var(--encre);
    color: var(--encre);
  }
  .journal__btn--ghost:hover {
    border-color: var(--rouge);
    color: var(--rouge);
  }

  .watch__add {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
  }
  .watch__add input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--encre);
    background: var(--encre);
    border: 1.5px solid var(--ligne);
    border-radius: 8px;
    padding: 11px 12px;
  }
  .watch__add input:focus {
    outline: 2px solid var(--lime);
    outline-offset: 1px;
    border-color: var(--encre);
  }

  .watch__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .watch__empty {
    color: var(--encre-2);
    font-size: 0.9rem;
    text-align: center;
    padding: 18px;
    border: 1px dashed var(--ligne);
    border-radius: 10px;
  }
  .wrow {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--carte);
    border: 1.5px solid var(--ligne);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .wrow__txt {
    flex: 1;
    font-size: 0.92rem;
    color: var(--encre);
    cursor: text;
  }
  .wrow__del {
    background: none;
    border: none;
    color: var(--encre-2);
    cursor: pointer;
    font-size: 1.05rem;
    padding: 2px 6px;
    border-radius: 6px;
  }
  .wrow__del:hover {
    color: var(--rouge);
    background: rgba(var(--rouge-rgb), 0.12);
  }
</style>

<script is:inline>
  (function () {
    const init = () => {
      const KEY = "fv_watch_v1";
      const root = document.querySelector(".watch[data-reveal]");
      if (!root) return;
      const form = root.querySelector("[data-form]");
      const list = root.querySelector("[data-list]");
      const empty = root.querySelector("[data-empty]");
      const load = () => {
        try {
          const data = JSON.parse(localStorage.getItem(KEY) || "[]");
          return Array.isArray(data)
            ? data.filter(
                (t) => t && typeof t === "object" && typeof t.id === "string",
              )
            : [];
        } catch {
          return [];
        }
      };
      const save = (a) => {
        try {
          localStorage.setItem(KEY, JSON.stringify(a));
          return true;
        } catch {
          alert(
            root.dataset.lang === "es"
              ? "No se pueden guardar las notas en este navegador. Exporta una copia."
              : "Impossible de sauvegarder les notes dans ce navigateur. Exporte une copie.",
          );
          return false;
        }
      };
      const esc = (s) =>
        String(s ?? "").replace(
          /[&<>"]/g,
          (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c],
        );

      function render() {
        const arr = load();
        list.innerHTML = "";
        if (!arr.length) {
          list.appendChild(empty);
          empty.style.display = "";
          return;
        }
        empty.style.display = "none";
        arr
          .slice()
          .reverse()
          .forEach((t) => {
            const li = document.createElement("li");
            li.className = "wrow";
            li.innerHTML = `<button type="button" class="wrow__txt" data-edit="${esc(t.id)}">${esc(t.txt)}</button><button class="wrow__del" data-del="${esc(t.id)}" aria-label="${root.dataset.lang === "es" ? "Borrar" : "Supprimer"}">✕</button>`;
            list.appendChild(li);
          });
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const inp = form.querySelector("input");
        const v = inp.value.trim();
        if (!v) return;
        const arr = load();
        arr.push({ id: Date.now().toString(36), txt: v });
        if (save(arr)) {
          render();
          inp.value = "";
        }
      });

      list.addEventListener("click", (e) => {
        const del = e.target.closest("[data-del]");
        if (del) {
          if (
            !confirm(
              root.dataset.lang === "es"
                ? "¿Eliminar este nivel?"
                : "Supprimer ce niveau ?",
            )
          )
            return;
          save(load().filter((t) => t.id !== del.dataset.del));
          render();
          return;
        }
        const ed = e.target.closest("[data-edit]");
        if (ed) {
          const id = ed.dataset.edit,
            es = root.dataset.lang === "es";
          const panel = document.createElement("form");
          panel.className = "watch-edit";
          const label = document.createElement("label");
          label.textContent = es ? "Editar la nota" : "Modifier la note";
          const input = document.createElement("input");
          input.value = ed.textContent;
          input.required = true;
          label.appendChild(input);
          panel.appendChild(label);
          const submit = document.createElement("button");
          submit.type = "submit";
          submit.textContent = es ? "Guardar" : "Enregistrer";
          const cancel = document.createElement("button");
          cancel.type = "button";
          cancel.textContent = es ? "Cancelar" : "Annuler";
          panel.append(submit, cancel);
          const row = ed.closest("li");
          row.replaceChildren(panel);
          input.focus();
          const restoreFocus = () => {
            render();
            Array.from(list.querySelectorAll("[data-edit]"))
              .find((b) => b.dataset.edit === id)
              ?.focus();
          };
          cancel.addEventListener("click", restoreFocus);
          input.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
              event.preventDefault();
              restoreFocus();
            }
          });
          panel.addEventListener("submit", (event) => {
            event.preventDefault();
            const arr = load(),
              item = arr.find((t) => t.id === id);
            if (item && input.value.trim()) {
              item.txt = input.value.trim();
              if (save(arr)) restoreFocus();
            }
          });
        }
      });

      root.querySelector("[data-clear]").addEventListener("click", () => {
        if (
          load().length &&
          confirm(
            root.dataset.lang === "es"
              ? "¿Borrar toda la lista?"
              : "Effacer toute la veille ?",
          )
        ) {
          save([]);
          render();
        }
      });
      root.querySelector("[data-export]").addEventListener("click", () => {
        const arr = load();
        if (!arr.length) return;
        const blob = new Blob([JSON.stringify(arr, null, 2)], {
          type: "application/json",
        });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "formationvvs-veille.json";
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      });

      render();
    };
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>
