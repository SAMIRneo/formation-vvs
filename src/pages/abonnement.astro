---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLang, localizedPath } from "../i18n/ui";
const lang = getLang(Astro.url),
  es = lang === "es";
const offers = es
  ? [
      [
        "Descubrimiento",
        "0 €",
        "Disponible ahora",
        [
          "4 módulos publicados",
          "16 preguntas de comprensión",
          "Herramientas educativas",
          "Progreso local",
        ],
      ],
      [
        "Trader",
        "29 €",
        "/ mes · propuesta",
        [
          "Recorrido estructurado",
          "Trabajo sobre escenarios",
          "Seguimiento educativo por definir",
        ],
      ],
      [
        "Pro",
        "79 €",
        "/ mes · propuesta",
        [
          "Acompañamiento por definir",
          "Revisión de escenarios",
          "Modalidades y disponibilidad a confirmar",
        ],
      ],
    ]
  : [
      [
        "Découverte",
        "0 €",
        "Disponible maintenant",
        [
          "4 modules publiés",
          "16 questions de compréhension",
          "Outils pédagogiques",
          "Progression locale",
        ],
      ],
      [
        "Trader",
        "29 €",
        "/ mois · proposition",
        [
          "Parcours structuré",
          "Travail sur les scénarios",
          "Suivi pédagogique à définir",
        ],
      ],
      [
        "Pro",
        "79 €",
        "/ mois · proposition",
        [
          "Accompagnement à définir",
          "Revue de scénarios",
          "Modalités et disponibilité à confirmer",
        ],
      ],
    ];
---

<BaseLayout
  title={es ? "Acceso y acompañamiento" : "Accès et accompagnement"}
  active="abonnement"
  ><section class="section wrap">
    <span class="eyebrow">{es ? "TU PRÓXIMA ETAPA" : "TA PROCHAINE ÉTAPE"}</span
    ><h1 style="max-width:17ch;margin:22px 0">
      {es ? "Empieza por comprender." : "Commence par comprendre."}
    </h1><p class="muted">
      {
        es
          ? "Los cursos y herramientas publicados son de acceso libre. Las fórmulas de acompañamiento siguientes son propuestas: no hay pago ni suscripción automática en este sitio."
          : "Les cours et outils publiés sont en accès libre. Les formules d’accompagnement ci-dessous sont des propositions : aucun paiement ni abonnement automatique n’est activé sur ce site."
      }
    </p><div class="offers">
      {
        offers.map((offer, i) => (
          <article
            class={`lab-panel offer ${i === 0 ? "offer--available" : ""}`}
          >
            <>
              <span class="eyebrow">
                {i === 0
                  ? es
                    ? "ACCESO LIBRE"
                    : "ACCÈS LIBRE"
                  : es
                    ? "POR CONFIRMAR"
                    : "À CONFIRMER"}
              </span>
              <h2>{offer[0]}</h2>
              <strong class="offer-price">{offer[1]}</strong>
              <p class="lab-note">{offer[2]}</p>
              <ul>
                {(offer[3] as string[]).map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                class={`btn ${i ? "btn--ghost" : ""}`}
                href={localizedPath(i ? "/contact/" : "/modules/", lang)}
              >
                {i
                  ? es
                    ? "Consultar modalidades"
                    : "Demander les modalités"
                  : es
                    ? "Empezar ahora"
                    : "Commencer maintenant"}{" "}
                ↗
              </a>
            </>
          </article>
        ))
      }
    </div><p class="info-note">
      {
        es
          ? "Un acompañamiento educativo no es gestión de cartera ni garantía de resultados. El contenido, calendario y condiciones de cualquier oferta de pago deben confirmarse antes de contratar."
          : "Un accompagnement pédagogique ne constitue ni une gestion de portefeuille ni une garantie de résultats. Le contenu, le calendrier et les conditions de toute offre payante restent à confirmer avant engagement."
      }
    </p>
  </section></BaseLayout
>
<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .offer {
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .offer h2 {
    font-size: 1.7rem;
    margin: 20px 0;
  }
  .offer-price {
    font-size: 3.2rem;
    font-weight: 500;
    letter-spacing: -0.06em;
  }
  .offer ul {
    list-style: none;
    margin: 25px 0 30px;
    flex: 1;
    display: grid;
    gap: 12px;
    font-size: 0.88rem;
    color: var(--encre-2);
  }
  .offer li {
    padding-left: 20px;
    position: relative;
  }
  .offer li::before {
    content: "+";
    position: absolute;
    left: 0;
    color: var(--lime);
  }
  .offer--available {
    border-color: var(--lime);
  }
  @media (max-width: 850px) {
    .offers {
      grid-template-columns: 1fr;
    }
    .offer .btn {
      width: 100%;
    }
  }
</style>
