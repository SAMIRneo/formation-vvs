---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLang, localizedPath } from "../i18n/ui";
const lang = getLang(Astro.url),
  es = lang === "es";
const subject = encodeURIComponent(
  es ? "FormationVVS — mi pregunta" : "FormationVVS — ma question",
);
---

<BaseLayout
  title={es ? "Contacto y preguntas" : "Contact et questions"}
  active="contact"
  ><section class="section wrap">
    <span class="eyebrow">{es ? "HABLEMOS" : "PARLONS-EN"} / VVS</span><h1
      style="max-width:15ch;margin:22px 0"
    >
      {
        es
          ? "Una pregunta puede cambiar tu lectura."
          : "Une question peut changer ta lecture."
      }
    </h1><p class="muted" style="max-width:52ch;margin-bottom:32px">
      {
        es
          ? "¿Una duda sobre un concepto, un error en un ejercicio o una idea para el recorrido? Escribe a Samir con el módulo y la situación que quieres aclarar."
          : "Une notion à éclaircir, une erreur dans un exercice ou une idée pour le parcours ? Écris à Samir avec le module et la situation que tu veux préciser."
      }
    </p><a class="btn" href={`mailto:neovvs75@gmail.com?subject=${subject}`}
      >{es ? "Escribir a Samir" : "Écrire à Samir"} ↗</a
    ><p class="lab-note" style="margin-top:16px">
      neovvs75@gmail.com · {
        es
          ? "Se abre tu aplicación de correo."
          : "Ouvre ton application de messagerie."
      }
    </p><div class="lab-duo" style="margin-top:50px">
      <article class="lab-panel">
        <h2>
          {es ? "Para preparar el intercambio" : "Pour préparer l’échange"}
        </h2><p class="muted" style="margin-top:20px">
          {
            es
              ? "Indica tu nivel, el concepto que te interesa y tu objetivo de aprendizaje. No envíes contraseñas ni información de acceso a una cuenta."
              : "Précise ton niveau, la notion qui t’intéresse et ton objectif d’apprentissage. N’envoie aucun mot de passe ni accès à un compte."
          }
        </p>
      </article><article class="lab-panel">
        <h2>
          {es ? "Mientras tanto, practica." : "En attendant, pratique."}
        </h2><p class="muted" style="margin:20px 0">
          {
            es
              ? "El recorrido y los ejercicios están disponibles sin crear una cuenta."
              : "Le parcours et les exercices sont disponibles sans créer de compte."
          }
        </p><a href={localizedPath("/modules/", lang)}
          >{es ? "Volver al recorrido" : "Retrouver le parcours"} →</a>
      </article>
    </div>
  </section></BaseLayout
>
