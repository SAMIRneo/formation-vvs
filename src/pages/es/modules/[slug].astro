---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterDiagram from '../../../components/ChapterDiagram.astro';
import { getContent } from '../../../data/content';
import { getLang, t, localizedPath } from '../../../i18n/ui';

export function getStaticPaths() {
  return getContent('es').modules.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const lang = getLang(Astro.url);
const accentVar = { orange: 'var(--lime)', bleu: 'var(--bleu)', jaune: 'var(--jaune)', emeraude: 'var(--emeraude)' }[m.accent || 'orange'];
const accentInkVar = { orange: 'var(--lime-ink)', bleu: 'var(--bleu-ink)', jaune: 'var(--jaune-ink)', emeraude: 'var(--emeraude-ink)' }[m.accent || 'orange'];
---
<BaseLayout title={m.title} active="modules">
  <article class="detail wrap" data-reveal>
    <a href={localizedPath('/modules/', lang)} class="back">{t(lang, 'modules.back')}</a>
    <span class="badge badge--orange">{m.tag}</span>
    <h1>{m.title}</h1>
    <p class="lead">{m.desc}</p>
    <p class="intro">{m.body}</p>

    <h2 class="chaps-title">{t(lang, 'modules.chapitres')}</h2>
    <div class="chapters">
      {m.chapters.map((c, i) => (
        <section class="chap" id={`chap-${i+1}`} style={`--accent:${accentVar}; --accent-ink:${accentInkVar}`} data-reveal>
          <div class="chap__head">
            <span class="chap__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="chap__headtext">
              <span class="chap__kicker">{t(lang, 'modules.chapitre')} {String(i + 1).padStart(2, '0')}</span>
              <h3 class="chap__t">{c.title}</h3>
            </div>
          </div>
          <figure class="chap__figure">
            <ChapterDiagram variant={c.diagram} lang={lang} />
            <figcaption class="chap__cap">{t(lang, 'modules.schema')} · {c.title}</figcaption>
          </figure>
          <p class="chap__body">{c.body}</p>
          {c.points && (
            <ul class="chap__pts">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="cta-row">
      <a href={localizedPath('/abonnement/', lang)} class="btn">{t(lang, 'nav.abonnement')}</a>
      <a href={localizedPath('/marche/', lang)} class="btn btn--ghost">{t(lang, 'nav.marche')}</a>
    </div>
  </article>
</BaseLayout>

<style>
  .detail { max-width: 760px; padding: 48px 20px 64px; }
  .back { display: inline-block; color: var(--encre-2); font-weight: 700; font-size: 0.85rem; margin-bottom: 20px; }
  .back:hover { color: var(--encre); }
  .detail h1 { font-size: clamp(2rem, 7vw, 3.4rem); margin: 14px 0 16px; }
  .lead { color: var(--encre-2); font-size: 1.1rem; margin-bottom: 20px; max-width: 52ch; }
  .intro { font-size: 1.02rem; line-height: 1.7; color: var(--encre); margin-bottom: 36px; }
  .chaps-title { font-size: clamp(1.4rem, 5vw, 2rem); margin-bottom: 24px; }
  .chapters { display: flex; flex-direction: column; gap: 28px; }
  .chap {
    position: relative; overflow: hidden; isolation: isolate;
    border: 1.5px solid var(--ligne); border-radius: var(--radius);
    padding: 24px; background: var(--carte); box-shadow: var(--ombre);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .chap::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(130% 90% at 100% 0%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 58%);
    opacity: 0; transition: opacity .3s ease;
  }
  .chap::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px;
    background: var(--accent); opacity: .9;
  }
  .chap:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 24px 48px -26px color-mix(in srgb, var(--accent) 38%, transparent); }
  .chap:hover::before { opacity: 1; }
  .chap__head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .chap__n {
    font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; line-height: 1;
    color: var(--accent-ink); letter-spacing: -0.04em; flex: 0 0 auto;
    width: 58px; height: 58px; display: grid; place-items: center;
    border: 1.5px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 12px; background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .chap__headtext { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .chap__kicker {
    font-family: var(--font-mono); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; font-size: 0.62rem; color: var(--accent-ink);
  }
  .chap__t { font-size: clamp(1.3rem, 5vw, 1.8rem); margin: 0; }
  .chap__figure {
    margin: 0 0 18px; border: 1.5px solid var(--ligne); border-radius: var(--radius-sm);
    background: var(--canvas); padding: 16px; box-shadow: inset 0 1px 0 rgba(255,255,255,.6);
  }
  .chap__figure :global(.cd) { border: none; padding: 0; background: transparent; box-shadow: none; }
  .chap__cap {
    margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--ligne);
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--encre-2); text-align: center;
  }
  .chap__body { font-size: 1rem; line-height: 1.68; color: var(--encre); margin: 0 0 16px; }
  .chap__pts { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .chap__pts li {
    font-size: 0.92rem; color: var(--encre); padding: 9px 12px 9px 34px; position: relative;
    background: var(--canvas); border: 1px solid var(--ligne); border-radius: 9px;
  }
  .chap__pts li::before {
    content: ''; position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    width: 8px; height: 8px; border-radius: 2px; background: var(--accent);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
  @media (max-width: 760px) {
    .detail { padding: 36px 16px 56px; }
    .chap { padding: 18px 16px; }
    .chapters { gap: 28px; }
  }
</style>
