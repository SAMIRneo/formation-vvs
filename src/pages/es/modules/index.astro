---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModuleCard from '../../../components/ModuleCard.astro';
import { getContent } from '../../../data/content';
import { getLang, t, localizedPath } from '../../../i18n/ui';
const lang = getLang(Astro.url);
const { modules } = getContent(lang);
---
<BaseLayout title={t(lang, 'modules.title')} active="modules">
  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">{t(lang, 'modules.title')}</span>
      <h2>{t(lang, 'modules.cursusTitle')}</h2>
      <p>{t(lang, 'modules.sub')}</p>
    </div>
    <div class="mods">
      {modules.map((m) => <ModuleCard {...m} diagram={m.chapters[0]?.diagram} href={localizedPath(`/modules/${m.slug}/`, lang)} />)}
    </div>
    <div class="cta-panel" data-reveal>
      <h2>{t(lang, 'modules.ctaTitle')}</h2>
      <p>{t(lang, 'modules.ctaLead')}</p>
      <a href={localizedPath('/abonnement/', lang)} class="btn">{t(lang, 'modules.ctaBtn')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sec-head { margin-bottom: 32px; }
  .sec-head p { color: var(--encre-2); margin-top: 10px; max-width: 48ch; }
  .mods { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .cta-panel { margin-top: 36px; padding: 40px; text-align: center; }
  .cta-panel p { max-width: 44ch; margin: 14px auto 26px;  font-weight: 500; }
  @media (max-width: 760px) { .mods { grid-template-columns: 1fr; } .cta-panel { padding: 30px 22px; } }
</style>
