---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { modules } from '../../data/content';
import { BASE_URL } from '../../consts';

export function getStaticPaths() {
  return modules.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
---
<BaseLayout title={m.title} active="formation">
  <article class="detail wrap" data-reveal>
    <a href={`${BASE_URL}/formation`} class="back">← Tous les cours</a>
    <span class="badge badge--orange">{m.tag}</span>
    <h1>{m.title}</h1>
    <p class="lead">{m.desc}</p>
    <div class="body">
      {m.body.split('\n').map((p) => <p>{p}</p>)}
    </div>
    <div class="cta-row">
      <a href={`${BASE_URL}/tarifs`} class="btn">Rejoindre la formation</a>
      <a href={`${BASE_URL}/outils`} class="btn btn--ghost">Voir les outils</a>
    </div>
  </article>
</BaseLayout>

<style>
  .detail { max-width: 720px; padding: 48px 20px 64px; }
  .back { display: inline-block; color: var(--texte-2); font-weight: 700; font-size: 0.85rem; margin-bottom: 20px; }
  .back:hover { color: var(--orange); }
  .detail h1 { font-size: clamp(2rem, 7vw, 3.4rem); margin: 14px 0 16px; }
  .lead { color: var(--texte-2); font-size: 1.1rem; margin-bottom: 28px; max-width: 52ch; }
  .body p { font-size: 1.02rem; line-height: 1.7; margin-bottom: 18px; color: var(--texte); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  @media (max-width: 760px) { .detail { padding: 36px 16px 56px; } }
</style>
