---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChapterDiagram from "../components/ChapterDiagram.astro";
import CandleLab from "../components/CandleLab.astro";
import RiskInstrument from "../components/RiskInstrument.astro";
import LearningProgress from "../components/LearningProgress.astro";
import { getContent } from "../data/content";
import { getLang, localizedPath } from "../i18n/ui";
const lang = getLang(Astro.url),
  es = lang === "es";
const { modules, tools } = getContent(lang);
const steps = es
  ? [
      ["01", "Observar", "Describe los hechos antes de buscar una señal."],
      ["02", "Comprender", "Relaciona estructura, horizonte y contexto."],
      ["03", "Manipular", "Cambia los valores. Comprueba sus consecuencias."],
      ["04", "Verificar", "Responde, corrige y guarda lo aprendido."],
    ]
  : [
      ["01", "Observer", "Décris les faits avant de chercher un signal."],
      ["02", "Comprendre", "Relie structure, horizon et contexte."],
      ["03", "Manipuler", "Change les valeurs. Vérifie leurs conséquences."],
      ["04", "Vérifier", "Réponds, corrige et garde une trace de tes acquis."],
    ];
---

<BaseLayout
  title={es
    ? "Entender el trading y calcular el riesgo"
    : "Comprendre le trading et calculer le risque"}
  active="accueil"
>
  <section class="lab-hero wrap">
    <div>
      <span class="eyebrow"
        >{es ? "EL TALLER DE LOS MERCADOS" : "L’ATELIER DES MARCHÉS"} / VVS</span
      ><h1>
        {
          es ? (
            <>
              El mercado
              <br />
              se lee.
              <>
                <br />
                <em>
                  El riesgo
                  <br />
                  se calcula.
                </em>
              </>
            </>
          ) : (
            <>
              Le marché
              <br />
              se lit.
              <>
                <br />
                <em>
                  Le risque
                  <br />
                  se calcule.
                </em>
              </>
            </>
          )
        }
      </h1><p class="lab-hero__lead">
        {
          es
            ? "Menos intuiciones vagas. Más observación, hipótesis y números. Un recorrido práctico para entender el trading antes de exponerse."
            : "Moins d’intuitions floues. Plus d’observations, d’hypothèses et de chiffres. Un parcours concret pour comprendre le trading avant de s’exposer."
        }
      </p><div class="lab-actions">
        <a class="btn" href={localizedPath("/modules/lire-le-prix/", lang)}
          >{es ? "Empezar el recorrido" : "Commencer le parcours"} ↗</a
        ><a class="btn btn--ghost" href="#laboratoire"
          >{es ? "Probar el laboratorio" : "Tester le laboratoire"}</a>
      </div><div class="lab-hero__index">
        <span><strong>04</strong>{es ? "módulos" : "modules"}</span><span
          ><strong>16</strong>{
            es ? "conceptos + ejercicios" : "notions + exercices"
          }</span
        ><span
          ><strong>FR</strong>{es ? "a tu ritmo" : "à ton rythme"}</span>
      </div>
    </div>
    <div class="lab-hero__art"><RiskInstrument lang={lang} /></div>
  </section>
  <section class="section wrap" id="parcours">
    <LearningProgress lang={lang} /><div class="curriculum-heading">
      <div>
        <span class="eyebrow"
          >{es ? "UN ORDEN PARA AVANZAR" : "UN ORDRE POUR AVANCER"}</span
        ><h2>
          {es ? "Del gráfico al escenario." : "Du graphique au scénario."}
        </h2>
      </div><p>
        {
          es
            ? "Cuatro etapas. Ejemplos claros. Un ejercicio para cada concepto."
            : "Quatre étapes. Des exemples clairs. Un exercice pour chaque notion."
        }
      </p>
    </div><div class="curriculum-grid">
      {
        modules.map((m, i) => (
          <a
            class="curriculum-card"
            href={localizedPath(`/modules/${m.slug}/`, lang)}
          >
            <>
              <div class="curriculum-card__top">
                <>
                  <strong>{m.n}</strong>
                  <span>{m.tag.toUpperCase()}</span>
                </>
              </div>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
              <ChapterDiagram
                variant={["candles", "trend", "positionsize", "plan"][i]}
                lang={lang}
                decorative
              />
              <span class="curriculum-card__go">
                {es ? "4 conceptos · 4 preguntas" : "4 notions · 4 questions"}{" "}
                <span aria-hidden="true">↗</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class="section section--alt">
    <div class="wrap">
      <div class="method-strip">
        {
          steps.map((s) => (
            <div>
              <>
                <span>{s[0]} /</span>
                <h3>{s[1]}</h3>
                <p>{s[2]}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section wrap" id="laboratoire">
    <div class="curriculum-heading">
      <div>
        <span class="eyebrow"
          >{es ? "APRENDER HACIENDO" : "APPRENDRE EN FAISANT"}</span
        ><h2>
          {es ? "Toca. Observa. Comprende." : "Touche. Observe. Comprends."}
        </h2>
      </div><p>
        {
          es
            ? "Ejemplos ficticios. Valores que puedes cambiar. Ninguna orden enviada."
            : "Des exemples fictifs. Des valeurs à faire varier. Aucun ordre envoyé."
        }
      </p>
    </div><div class="lab-duo">
      <CandleLab lang={lang} /><div class="lab-panel">
        <span class="eyebrow">LAB / 02 · POSITION</span><h2
          style="margin:14px 0 22px"
        >
          {es ? "¿Cuántas unidades?" : "Combien d’unités ?"}
        </h2><ChapterDiagram variant="positionsize" lang={lang} /><p
          style="margin:24px 0;color:var(--encre-2)"
        >
          {
            es
              ? "Un presupuesto de 50 € y una distancia entrada-stop de 5 € dan 10 unidades, antes de costes. El capital disponible también limita la posición."
              : "Un budget de 50 € et une distance entrée-stop de 5 € donnent 10 unités, avant frais. Le capital disponible limite aussi la position."
          }
        </p><a class="btn" href={localizedPath("/outils/calculateur/", lang)}
          >{es ? "Abrir el calculador" : "Ouvrir le calculateur"} ↗</a>
      </div>
    </div>
  </section>
  <section class="lab-editorial">
    <div class="wrap">
      <span class="eyebrow"
        >{es ? "PRIMERO, ENTENDER" : "D’ABORD, COMPRENDRE"}</span
      ><h2>
        {
          es
            ? "Una buena pregunta vale más que una falsa certeza."
            : "Une bonne question vaut mieux qu’une fausse certitude."
        }
      </h2><p>
        {
          es
            ? "Una figura no promete una ganancia. Un stop no garantiza su precio. Un ratio atractivo no demuestra una ventaja. Aquí aprendemos a describir las condiciones, calcular la exposición y reconocer los límites de un modelo."
            : "Une figure ne promet pas un gain. Un stop ne garantit pas son prix. Un ratio séduisant ne prouve pas un avantage. Ici, on apprend à décrire des conditions, calculer une exposition et reconnaître les limites d’un modèle."
        }
      </p><div class="resource-links">
        <a
          href="https://www.amf-france.org/fr/espace-epargnants/comprendre-les-produits-financiers/produits-complexes/cfd"
          target="_blank"
          rel="noopener"
          >AMF · {es ? "Riesgos de los CFD" : "Risques des CFD"} ↗</a
        ><a
          href="https://www.investor.gov/introduction-investing/investing-basics/how-stock-markets-work/types-orders"
          target="_blank"
          rel="noopener"
          >Investor.gov · {es ? "Tipos de órdenes" : "Types d’ordres"} ↗</a>
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="curriculum-heading">
      <div>
        <span class="eyebrow">{es ? "TU BANCO DE TRABAJO" : "TON ÉTABLI"}</span
        ><h2>
          {es ? "Prepara. Documenta. Revisa." : "Prépare. Documente. Revois."}
        </h2>
      </div><a class="btn btn--ghost" href={localizedPath("/marche/", lang)}
        >{es ? "Explorar las herramientas" : "Explorer les outils"} ↗</a>
    </div><div class="tool-list">
      {
        tools.map((tool) => (
          <a href={localizedPath(`/outils/${tool.slug}/`, lang)}>
            <>
              <h3>{tool.t} ↗</h3>
              <p>{tool.d}</p>
            </>
          </a>
        ))
      }
    </div><div class="faq">
      <details>
        <summary
          >{es ? "¿Necesito una cuenta?" : "Faut-il créer un compte ?"}</summary
        ><p>
          {
            es
              ? "No. Los cursos y herramientas publicados se pueden consultar libremente. El progreso y las notas se guardan en este navegador y no se sincronizan."
              : "Non. Les cours et outils publiés sont librement consultables. La progression et les notes restent dans ce navigateur et ne sont pas synchronisées."
          }
        </p>
      </details><details>
        <summary
          >{
            es
              ? "¿Son señales de trading?"
              : "Est-ce un service de signaux de trading ?"
          }</summary
        ><p>
          {
            es
              ? "No. Los esquemas y ejercicios son ilustrativos. Los precios provienen de proveedores externos y pueden estar retrasados o no disponibles. Ninguna herramienta ejecuta operaciones."
              : "Non. Les schémas et exercices sont illustratifs. Les prix proviennent de fournisseurs externes et peuvent être retardés ou indisponibles. Aucun outil n’exécute d’opération."
          }
        </p>
      </details><details>
        <summary>{es ? "¿Por dónde empezar?" : "Par où commencer ?"}</summary><p
        >
          {
            es
              ? "Empieza por Leer el precio, responde a las cuatro preguntas y continúa con estructura y riesgo. Puedes regresar a cualquier concepto."
              : "Commence par Lire le prix, réponds aux quatre questions puis poursuis avec la structure et le risque. Tu peux revenir sur chaque notion à tout moment."
          }
        </p>
      </details>
    </div>
  </section>
</BaseLayout>
