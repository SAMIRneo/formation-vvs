---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketBoard from '../components/MarketBoard.astro';
import ChapterDiagram from '../components/ChapterDiagram.astro';
import { getContent } from '../data/content';
import { getLang, t, localizedPath } from '../i18n/ui';
const lang = getLang(Astro.url);
const { modules } = getContent(lang);
// miniature de schéma par module (variant ChapterDiagram)
const diagramVariant = ['candles', 'trend', 'positionsize', 'annotated'];
---
<BaseLayout title={t(lang, 'home.heroTitle').split('\n')[0]} active="accueil">
  <!-- HERO ÉDITORIAL -->
  <section class="hero wrap">
    <div class="hero__main" data-reveal>
      <span class="eyebrow">{t(lang, 'home.eyebrow')}</span>
      <h1 class="hero__title anim-hero" set:html={t(lang, 'home.heroTitle').replace(/\n/g, '<br/>')} />
      <p class="hero__lead">{t(lang, 'home.heroLead')}</p>
      <div class="hero__cta">
        <a href={localizedPath('/modules/', lang)} class="btn anim-cta">{t(lang, 'home.ctaModules')}</a>
        <a href={localizedPath('/abonnement/', lang)} class="btn btn--ghost anim-cta">{t(lang, 'home.ctaAbo')}</a>
      </div>
      <div class="hero__stats">
        <div><span class="num">4</span><span class="lab">modules</span></div>
        <div><span class="num">FR / ES</span><span class="lab">langues</span></div>
        <div><span class="num">100%</span><span class="lab">sur iPhone</span></div>
      </div>
    </div>
  </section>

  <!-- MANIFESTE -->
  <section class="section section--alt manifesto">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{t(lang, 'home.manifesteEyebrow')}</span>
      <p class="manifesto__text" data-reveal data-reveal-delay="60" set:html={t(lang, 'home.manifeste').replace(/\n/g, '<br/>')} />
    </div>
  </section>

  <!-- MODULES (bento éditorial) -->
  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <h2 class="anim-title">{t(lang, 'home.cursusTitle')}</h2>
      <p class="muted">{t(lang, 'home.cursusLead')}</p>
    </div>
    <div class="modbento">
      {modules.map((m, i) => (
        <a href={localizedPath(`/modules/${m.slug}/`, lang)} class="modbento__card" data-reveal data-reveal-delay={(i % 2) * 80} data-parallax={i % 2 ? "0.09" : "-0.09"} style={`--accent:${['var(--lime)','var(--bleu)','var(--jaune)','var(--emeraude)'][i]}`}>
          <div class="modbento__top">
            <span class="modbento__n">{m.n}</span>
            <span class="badge">{m.tag}</span>
          </div>
          <h3 class="modbento__t">{m.title}</h3>
          <p class="modbento__d">{m.desc}</p>
          <div class="modbento__diagram">
            <ChapterDiagram variant={diagramVariant[i]} lang={lang} />
          </div>
          <span class="modbento__go">{t(lang, 'home.ctaModules')} <span class="modbento__arrow">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- MARCHÉ (section dédiée) -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <h2 class="anim-title">{t(lang, 'home.marcheTitle')}</h2>
        <p class="muted">{t(lang, 'home.marcheLead')}</p>
      </div>
      <div class="marche-grid" data-reveal>
        <MarketBoard />
      </div>
      <a href={localizedPath('/marche/', lang)} class="board-card__link marche-link">{t(lang, 'home.marcheLink')} →</a>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section">
    <div class="wrap cta-final" data-reveal>
      <h2 class="cta-final__title anim-title">{t(lang, 'home.ctaPanelTitle')}</h2>
      <p class="cta-final__lead muted">{t(lang, 'home.ctaPanelLead')}</p>
      <a href={localizedPath('/abonnement/', lang)} class="btn anim-cta">{t(lang, 'home.ctaPanelBtn')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 96px 22px 72px; min-height: 62vh; justify-content: center;
  }
  .hero__main { display: flex; flex-direction: column; align-items: center; gap: 22px; max-width: 880px; }
  .hero__lead { color: var(--encre); font-size: 1.18rem; max-width: 52ch; line-height: 1.6; margin-top: 4px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .hero__stats { display: flex; gap: 40px; margin-top: 16px; padding-top: 24px; border-top: 1px solid var(--ligne); }
  .hero__stats > div { display: flex; flex-direction: column; }
  .hero__stats .num { font-family: var(--font-display); font-weight: 600; font-size: 1.8rem; line-height: 1; }
  .hero__stats .lab { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--encre-2); margin-top: 6px; }

  /* manifeste */
  .manifesto .eyebrow { margin-bottom: 22px; }
  .manifesto__text {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.5rem, 3.6vw, 2.5rem); line-height: 1.25; letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .manifesto__text :global(br) { margin-bottom: 0.2em; }

  /* sec-head */
  .sec-head { margin-bottom: 30px; }
  .sec-head .muted { margin-top: 8px; max-width: 60ch; }

  /* bento modules */
  .modbento {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    overflow: visible; padding: 28px 0;
  }
  .modbento__card {
    position: relative; overflow: hidden; display: flex; flex-direction: column;
    background: var(--carte); border: 1.5px solid var(--ligne); border-radius: var(--radius);
    padding: 24px; box-shadow: 0 14px 30px -16px rgba(20,19,15,0.25);
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    will-change: transform;
  }
  .modbento__card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%);
    opacity: 0; transition: opacity .25s ease;
  }
  .modbento__card:hover { transform: translateY(-6px); border-color: var(--accent); box-shadow: 0 30px 56px -22px color-mix(in srgb, var(--accent) 42%, rgba(20,19,15,0.3)); }
  .modbento__card:hover::before { opacity: 1; }
  .modbento__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .modbento__n { font-family: var(--font-display); font-weight: 600; font-size: 2.4rem; color: var(--accent); letter-spacing: -0.04em; line-height: 1; }
  .modbento__t { font-size: clamp(1.4rem, 4vw, 1.9rem); margin-bottom: 8px; letter-spacing: -0.01em; }
  .modbento__d { color: var(--encre-2); font-size: 0.92rem; line-height: 1.5; max-width: 40ch; margin-bottom: 18px; }
  .modbento__diagram {
    margin-top: auto; border: 1.5px solid var(--ligne); border-radius: var(--radius-sm);
    background: var(--canvas); padding: 12px; overflow: hidden;
  }
  .modbento__go {
    margin-top: 16px; font-family: var(--font-mono); font-weight: 700; font-size: 0.78rem;
    text-transform: uppercase; letter-spacing: 0.02em; color: var(--encre); display: inline-flex; align-items: center; gap: 8px;
  }
  .modbento__card:hover .modbento__go { color: var(--accent); }
  .modbento__arrow { transition: transform .2s ease; }
  .modbento__card:hover .modbento__arrow { transform: translateX(5px); }

  /* marché section */
  .marche-grid { max-width: 760px; }
  .marche-link { display: inline-block; margin-top: 18px; }

  /* cta final */
  .cta-final { text-align: center; max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cta-final__lead { max-width: 48ch; }
  .cta-final .btn { margin-top: 8px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding-top: 56px; }
    .modbento { grid-template-columns: 1fr; gap: 34px; padding: 24px 0; }
  }
  @media (max-width: 640px) {
    .hero__stats { gap: 22px; }
  }
</style>
