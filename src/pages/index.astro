---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketBoard from '../components/MarketBoard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { modules } from '../data/content';
import { getLang, t, localizedPath } from '../i18n/ui';
const lang = getLang(Astro.url);
---
<BaseLayout title={t(lang, 'home.heroTitle').split('\n')[0]} active="accueil">
  <!-- HERO PARALLAX -->
  <section class="hero-parallax wrap">
    <div class="hero-parallax__bg" data-parallax="0.18"></div>
    <div class="hero-parallax__grid" data-parallax="0.08"></div>
    <div class="hero-parallax__content hero" data-reveal>
      <span class="eyebrow">{t(lang, 'home.eyebrow')}</span>
      <h1 set:html={t(lang, 'home.heroTitle').replace(/\n/g, '<br/>')} />
      <p class="hero__lead">{t(lang, 'home.heroLead')}</p>
      <div class="hero__cta">
        <a href={localizedPath('/modules/', lang)} class="btn">{t(lang, 'home.ctaModules')}</a>
        <a href={localizedPath('/abonnement/', lang)} class="btn btn--ghost">{t(lang, 'home.ctaAbo')}</a>
      </div>
    </div>
  </section>

  <!-- BENTO GRID -->
  <section class="section wrap">
    <div class="bento">

      <!-- Marché (large) -->
      <div class="bento__card b-wide is-accent" data-reveal>
        <span class="bento__k">{t(lang, 'home.marcheEyebrow')}</span>
        <h2 class="bento__t">{t(lang, 'home.marcheTitle')}</h2>
        <p class="bento__d" style="margin-bottom:16px">{t(lang, 'home.marcheLead')}</p>
        <MarketBoard />
        <a href={localizedPath('/marche/', lang)} class="market-link">{t(lang, 'home.marcheLink')}</a>
      </div>

      <!-- CTA panneau couleur (half) -->
      <div class="bento__card b-half panel-orange" data-reveal data-reveal-delay="80">
        <div class="cta-mini">
          <h3>{t(lang, 'home.ctaPanelTitle')}</h3>
          <p>{t(lang, 'home.ctaPanelLead')}</p>
          <a href={localizedPath('/abonnement/', lang)} class="btn">{t(lang, 'home.ctaPanelBtn')}</a>
        </div>
      </div>

      <!-- Modules titres (b-full intro) -->
      <div class="bento__card b-full" data-reveal>
        <div class="sec-head" style="margin-bottom:20px">
          <h2 class="bento__t">{t(lang, 'home.cursusTitle')}</h2>
          <p class="bento__d">{t(lang, 'home.cursusLead')}</p>
        </div>
        <div class="mods-bento">
          {modules.map((m, i) => (
            <a href={localizedPath(`/modules/${m.slug}/`, lang)} class="mod-bento" data-reveal data-reveal-delay={i*60}>
              <span class="mod-bento__n">{m.n}</span>
              <div>
                <h3 class="mod-bento__t">{m.title}</h3>
                <p class="mod-bento__d">{m.desc}</p>
              </div>
              <span class="mod-bento__tag">{m.tag}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .hero-parallax { padding: 72px 20px 56px; min-height: 64vh; display: flex; align-items: center; }
  .hero { width: 100%; max-width: 820px; display: flex; flex-direction: column; gap: 24px; }
  .hl { color: var(--orange); }
  .hero__lead { color: var(--texte-2); font-size: 1.12rem; margin: 22px 0 30px; max-width: 52ch; line-height: 1.6; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .market-link { display: inline-block; margin-top: 16px; color: var(--orange); font-weight: 700; font-size: 0.85rem; }

  .cta-mini { display: flex; flex-direction: column; height: 100%; }
  .cta-mini h3 { font-size: clamp(1.2rem, 4vw, 1.6rem); margin-bottom: 10px; color: #1A0D00; text-transform: uppercase; letter-spacing: -0.03em; font-family: var(--font-display); font-weight: 700; line-height: 1; }
  .cta-mini p { color: #2A1500; font-weight: 500; font-size: 0.92rem; margin-bottom: 16px; flex: 1 1 auto; }
  .cta-mini .btn { background: var(--charbon); color: var(--orange); border-color: #1A0D00; align-self: flex-start; }

  .sec-head { margin: 0; }
  .mods-bento { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .mod-bento {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    background: var(--charbon-3); border: var(--border-w) solid var(--ligne);
    border-radius: 12px; padding: 16px 18px; transition: border-color .15s ease, transform .15s ease;
  }
  .mod-bento:hover { border-color: var(--orange); transform: translateY(-2px); }
  .mod-bento__n { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--orange); letter-spacing: -0.04em; }
  .mod-bento__t { font-size: 1.05rem; margin: 0 0 2px; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: -0.02em; }
  .mod-bento__d { font-size: 0.8rem; color: var(--texte-2); margin: 0; }
  .mod-bento__tag { font-family: var(--font-body); font-weight: 700; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; padding: 3px 8px; border: var(--border-w) solid var(--ligne); border-radius: 6px; color: var(--texte-2); }

  @media (max-width: 1024px) {
    .hero-parallax { padding-top: 56px; }
    .board { grid-template-columns: 1fr !important; }
    :global(.board .tile) { flex-direction: row !important; align-items: center; gap: 12px; }
  }
  @media (max-width: 760px) {
    .hero-parallax { padding: 44px 16px 36px; min-height: 56vh; }
    .hero__lead { font-size: 1.05rem; }
    .hero__cta { flex-direction: column; align-items: stretch; }
    .hero__cta .btn { width: 100%; justify-content: center; }
    .mods-bento { grid-template-columns: 1fr; }
    .bento__card { padding: 18px 16px; }
  }
  @media (max-width: 640px) {
    .hero h1 { font-size: clamp(2.3rem, 11vw, 3.4rem); }
  }
</style>
