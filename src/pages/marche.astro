---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketBoard from '../components/MarketBoard.astro';
import { getContent } from '../data/content';
import { getLang, t, localizedPath } from '../i18n/ui';
const lang = getLang(Astro.url);
const { tools } = getContent(lang);
---
<BaseLayout title={t(lang, 'marche.title')} active="marche">
  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">{t(lang, 'home.marcheEyebrow')}</span>
      <h2>{t(lang, 'home.marcheTitle')}</h2>
      <p>{t(lang, 'marche.lead')}</p>
    </div>
    <MarketBoard />
  </section>

  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">{t(lang, 'marche.toolsTitle')}</span>
      <h2>{t(lang, 'marche.toolsSub')}</h2>
      <p>{t(lang, 'marche.toolsLead')}</p>
    </div>
    <div class="tools">
      {tools.map((tool) => (
        <a class="tool" href={localizedPath(`/outils/${tool.slug}/`, lang)} data-reveal>
          <span class="tool__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={tool.icon} /></svg>
          </span>
          <h3 class="tool__t">{t(lang, `marche.${tool.slug}Name`)}</h3>
          <p class="tool__d">{t(lang, `marche.${tool.slug}Desc`)}</p>
          <span class="tool__go">Ouvrir →</span>
        </a>
      ))}
    </div>
    <div class="cta-panel" data-reveal>
      <h2>{t(lang, 'marche.ctaTitle')}</h2>
      <p>{t(lang, 'marche.ctaLead')}</p>
      <a href={localizedPath('/modules/', lang)} class="btn">{t(lang, 'marche.ctaBtn')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sec-head { margin-bottom: 32px; }
  .sec-head p { color: var(--encre-2); margin-top: 10px; max-width: 52ch; }
  .tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .tool {
    background: var(--carte); border: 1.5px solid var(--ligne);
    border-radius: var(--radius); padding: 22px; transition: border-color .14s ease, transform .14s ease;
  }
  .tool:hover { border-color: var(--encre); transform: translateY(-4px); }
  .tool__ic { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 9px;
    background: color-mix(in srgb, var(--lime) 14%, transparent); color: var(--encre); margin-bottom: 14px; }
  .tool__ic svg { width: 22px; height: 22px; }
  .tool__t { font-size: 1.2rem; margin-bottom: 8px; }
  .tool__d { color: var(--encre-2); font-size: 0.9rem; }
  .tool__go { margin-top: 12px; font-family: var(--font-body); font-weight: 700; font-size: 0.8rem; color: var(--encre); display: inline-flex; align-items: center; gap: 6px; }
  .tool__go { transition: gap .18s ease; }
  .tool:hover .tool__go { gap: 11px; }
  .cta-panel { margin-top: 36px; padding: 40px; text-align: center; }
  .cta-panel p { max-width: 44ch; margin: 14px auto 26px;  font-weight: 500; }
  @media (max-width: 760px) { .tools { grid-template-columns: 1fr; } .cta-panel { padding: 30px 22px; } }
</style>
