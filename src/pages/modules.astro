---
import BaseLayout from "../layouts/BaseLayout.astro";
import LearningProgress from "../components/LearningProgress.astro";
import ModuleCard from "../components/ModuleCard.astro";
import { getContent } from "../data/content";
import { getLang, t, localizedPath } from "../i18n/ui";
const lang = getLang(Astro.url);
const { modules } = getContent(lang);
---

<BaseLayout title={t(lang, "modules.title")} active="modules">
  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">{t(lang, "modules.title")}</span>
      <h1>
        {
          lang === "es"
            ? "Aprender, una idea a la vez."
            : "Apprendre, une idée à la fois."
        }
      </h1>
      <p>
        {
          lang === "es"
            ? "De la observación al escenario: cuatro etapas y dieciséis ejercicios para comprobar tu comprensión."
            : "De l’observation au scénario : quatre étapes et seize exercices pour vérifier ta compréhension."
        }
      </p>
    </div>
    <LearningProgress lang={lang} />
    <div class="mods">
      {
        modules.map((m) => (
          <ModuleCard
            {...m}
            diagram={m.chapters[0]?.diagram}
            lang={lang}
            href={localizedPath(`/modules/${m.slug}/`, lang)}
          />
        ))
      }
    </div>
    <div class="cta-panel" data-reveal>
      <h2>
        {
          lang === "es"
            ? "Prueba los números."
            : "Mets les chiffres à l’épreuve."
        }
      </h2>
      <p>
        {
          lang === "es"
            ? "Cambia entrada, stop, objetivo y costes para entender cómo cambia la cantidad."
            : "Fais varier entrée, stop, objectif et frais pour comprendre ce qui change dans la quantité."
        }
      </p>
      <a href={localizedPath("/outils/calculateur/", lang)} class="btn anim-cta"
        >{lang === "es" ? "Abrir el calculador" : "Ouvrir le calculateur"}</a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .sec-head {
    margin-bottom: 32px;
  }
  .sec-head p {
    color: var(--encre-2);
    margin-top: 10px;
    max-width: 48ch;
  }
  .mods {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .cta-panel {
    margin-top: 36px;
    padding: 40px;
    text-align: center;
  }
  .cta-panel p {
    max-width: 44ch;
    margin: 14px auto 26px;
    font-weight: 500;
  }
  @media (max-width: 760px) {
    .mods {
      grid-template-columns: 1fr;
    }
    .cta-panel {
      padding: 30px 22px;
    }
  }
</style>
