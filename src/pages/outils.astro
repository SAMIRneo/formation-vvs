---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/content';
import { BASE_URL } from '../consts';
---
<BaseLayout title="Outils" active="outils">
  <section class="section wrap">
    <div class="sec-head" data-reveal>
      <span class="eyebrow">Boîte à outils</span>
      <h2>Les outils qui servent.</h2>
      <p>Rien de superflu. Quatre outils qui rendent ta méthode exécutable au quotidien.</p>
    </div>
    <div class="tools">
      {tools.map((t) => (
        <a class="tool" href={`${BASE_URL}/outils/${t.slug}/`}>
          <div class="tool__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg></div>
          <h3>{t.t}</h3>
          <p>{t.d}</p>
          <span class="tool__go">Ouvrir →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .sec-head { margin-bottom: 36px; }
  .sec-head p { color: var(--texte-2); margin-top: 12px; max-width: 48ch; }
  .tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .tool {
    display: block; background: var(--charbon-2); border: var(--border-w) solid var(--ligne);
    border-radius: var(--radius); padding: 24px;
    transition: border-color .14s ease, transform .14s ease;
  }
  .tool:hover { border-color: var(--bleu); transform: translateY(-4px); }
  .tool__ic { width: 46px; height: 46px; border: var(--border-w) solid var(--bleu); border-radius: 8px; display: grid; place-items: center; color: var(--bleu); margin-bottom: 16px; }
  .tool__ic svg { width: 24px; height: 24px; }
  .tool h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .tool p { color: var(--texte-2); font-size: 0.9rem; }
  .tool__go { display: inline-block; margin-top: 14px; font-weight: 700; font-size: 0.8rem; color: var(--bleu); }
  @media (max-width: 760px) { .tools { grid-template-columns: 1fr; } }
</style>
